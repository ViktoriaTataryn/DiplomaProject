@using diplomaProject.Models
@model IEnumerable<diplomaProject.Models.Module>

@{
    ViewData["Title"] = "Additional Materials";
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">Archive: Additional Materials</h1>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">No materials available at the moment.</div>
    }
    else
    {
        <div class="row">
            @foreach (var module in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm border-0">
                        @* Header styles from Figma profile style *@
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center" style="border-radius: 12px 12px 0 0;">
                            <h3 class="card-title mb-0 h5">Module @module.OrderIndex: @module.Title</h3>
                        </div>
                        <div class="card-body">
                            @if (module.Lessons == null || !module.Lessons.Any())
                            {
                                <p class="text-muted small">No lessons available in this module.</p>
                            }
                            else
                            {
                                @foreach (var lesson in module.Lessons.OrderBy(l => l.LessonIndex))
                                {
                                    <div class="lesson-section mb-3 p-2 border-bottom">
                                        <h5 class="h6 fw-bold">Lesson @lesson.LessonIndex: @lesson.Title</h5>
                                        <ul class="list-group list-group-flush">
                                            @foreach (var resource in lesson.Resources)
                                            {
                                                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                                                    <span class="text-truncate me-2">
                                                        <i class="bi bi-file-earmark-arrow-down me-2"></i>
                                                        @resource.FileName
                                                    </span>
                                                    <a asp-action="DownloadResource" asp-controller="Course" asp-route-resourceId="@resource.Id" 
                                                       class="btn btn-sm btn-outline-success flex-shrink-0">
                                                        Download
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Styling for smooth UI experience *@
<style>
    .card { border-radius: 12px; transition: all 0.3s ease; }
    .card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important; }
    .list-group-item { border: none; }
</style>