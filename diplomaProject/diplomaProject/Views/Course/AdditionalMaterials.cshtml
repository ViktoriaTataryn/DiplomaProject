 @model IEnumerable<diplomaProject.Models.Module>

@{
    ViewData["Title"] = "Додаткові матеріали";
}

<link rel="stylesheet" href="~/css/resources.css" asp-append-version="true" />

<div class="container-fluid py-4" style="background-color: var(--brand-light); min-height: 100vh;">

    <div class="archive-header p-4 p-md-5 mb-4">
        <div class="archive-bg-flowers"></div>

        <div class="position-relative" style="z-index: 1; max-width: 600px;">
            <h1 class="text-brand mb-3" style="text-transform: uppercase; font-weight: 300; font-size: 2rem;">Архів курсу</h1>
            <p class="text-muted mb-4" style="font-size: 1.1rem; font-weight: 300; line-height: 1.5;">
                Завантажте всі лекції, матеріали та додаткові файли одним архівом.<br />
                Всі файли стануть доступно після оплати курсу.
            </p>

            <div class="d-flex align-items-center mb-4 text-muted" style="font-size: 0.9rem;">
                <span class="me-4"><i class="bi bi-file-earmark me-2"></i>23 файли</span>
                <span><i class="bi bi-hdd me-2"></i>1,2 гб</span>
            </div>

            <a asp-controller="Course" asp-action="DownloadFullArchive" class="btn btn-brand px-5 py-3 w-100 w-md-auto font-weight-bold text-decoration-none d-inline-block text-center" style="letter-spacing: 1px;">
                ЗАВАНТАЖИТИ ВЕСЬ КУРС
            </a>
        </div>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <h2 class="text-brand m-0 mb-3 mb-md-0" style="text-transform: uppercase; font-weight: 300; font-size: 1.8rem;">
            Матеріали за лекціями
        </h2>

        <div class="d-flex flex-column flex-sm-row gap-3">
            <div class="input-group" style="max-width: 300px; border: 1px solid #ced4da; border-radius: 2px;">
                <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-0 ps-0" placeholder="Шукати..." style="box-shadow: none;">
            </div>
            <select class="form-select text-brand" style="max-width: 150px; border-color: #ced4da; border-radius: 2px;">
                <option selected>Модуль <i class="bi bi-chevron-down"></i></option>
                @foreach (var m in Model)

                {
                    <option value="@m.Id">Модуль @m.OrderIndex</option>
                }
            </select>
        </div>
    </div>

    @{
        // Перевіряємо, чи є взагалі хоч один файл (Resource) у всіх модулях
        var allResources = Model.SelectMany(m => m.Lessons).SelectMany(l => l.Resources ?? new List<diplomaProject.Models.Resource>()).ToList();
    }

    <div class="bg-white p-4 p-md-5 mb-5" style="border-radius: 4px; box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.02);">
        @if (!allResources.Any())
        {
            <div class="alert alert-info text-center">Матеріали поки що відсутні.</div>
        }
        else
        {
            @foreach (var module in Model)
            {
                foreach (var lesson in module.Lessons.OrderBy(l => l.LessonIndex))
                {
                    // Перевіряємо чи є файли саме в цій лекції
                    if (lesson.Resources != null && lesson.Resources.Any())
                    {
                        foreach (var resource in lesson.Resources)
                        {
                            <div class="lesson-material-card flex-column flex-md-row text-center text-md-start">

                                <div class="flex-shrink-0 mb-3 mb-md-0">
                                    <div class="lesson-thumbnail-frame bg-light border-0">
                                        <i class="bi bi-file-earmark-text text-brand" style="font-size: 2rem;"></i>
                                    </div>
                                </div>

                                <div class="flex-grow-1 text-start ps-md-3">
                                    <div class="lesson-meta text-uppercase">
                                        Модуль @module.OrderIndex. &bull; Тема @lesson.LessonIndex.
                                    </div>
                                    <h3 class="lesson-title fw-bold" style="font-family: 'Gilroy', sans-serif;">@resource.FileName</h3>
                                </div>

                                <div class="flex-shrink-0 d-flex gap-3 align-items-center mt-3 mt-md-0 justify-content-center">
                                    @if (!string.IsNullOrEmpty(resource.FilePath))
                                    {
                                        string viewLink = resource.FilePath.StartsWith("http")
                                            ? resource.FilePath
                                            : Url.Content("~/materials/" + resource.FilePath.TrimStart('/'));
                                            
                                        <a href="@viewLink" target="_blank" class="btn btn-outline-brand px-4 py-2 text-decoration-none" style="text-transform: uppercase; font-size: 0.85rem;">
                                            Переглянути
                                        </a>
                                    }
                                    
                                    <a asp-controller="Course" asp-action="DownloadResource" asp-route-resourceId="@resource.Id" class="btn btn-outline-brand px-3 py-2 d-flex align-items-center justify-content-center text-decoration-none">
                                        <i class="bi bi-download" style="font-size: 1.2rem;"></i>
                                    </a>
                                </div>

                            </div>
                        }
                    }
                }
            }
        }
    </div>
</div>

@section Scripts {
}