@model IEnumerable<diplomaProject.Models.Module>

@{
    ViewData["Title"] = "Додаткові матеріали";
}

@* Removed link to resources.css as we merged it into site.css *@
@* Structure updated to match Figma parameters: Course Progress Card (max-width: 1580px, height: 405px) Materials Section (max-width: 1580px, padding: 24px, gap: 32px) *@

<div class="container-fluid py-4 d-flex flex-column align-items-center" style="background-color: var(--brand-light); min-height: 100vh;">
    
    @* Course Progress Card (Archive Header) *@
    <div class="archive-header w-100 mb-4 d-flex align-items-center" style="max-width: 1580px; min-height: 405px; padding: 24px;">
        <div class="archive-bg-flowers"></div>
        
        <div class="position-relative" style="z-index: 1; max-width: 600px;">
            <h1 class="text-brand mb-3" style="text-transform: uppercase; font-weight: 300; font-size: 2rem;">Архів курсу</h1>
            <p class="text-muted mb-4" style="font-size: 1.1rem; font-weight: 300; line-height: 1.5;">
                Завантажте всі лекції, матеріали та додаткові файли одним архівом.<br />
                Всі файли стануть доступно після оплати курсу.
            </p>
            
            <div class="d-flex align-items-center mb-4 text-muted" style="font-size: 0.9rem;">
                <span class="me-4"><i class="bi bi-file-earmark me-2"></i>23 файли</span>
                <span><i class="bi bi-hdd me-2"></i>1,2 гб</span>
            </div>
            
            @* Link connected to DownloadFullArchive action in CourseController *@
            <a asp-controller="Course" asp-action="DownloadFullArchive" class="btn btn-brand px-5 py-3 w-100 w-md-auto font-weight-bold shadow-sm text-center" style="letter-spacing: 1px; text-decoration: none; display: inline-block;">
                ЗАВАНТАЖИТИ ВЕСЬ КУРС
            </a>
        </div>
    </div>

    @* Materials Section Container *@
    <div class="materials-section w-100" style="max-width: 1580px;">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <h2 class="text-brand m-0 mb-3 mb-md-0" style="text-transform: uppercase; font-weight: 300; font-size: 1.8rem;">
                Матеріали за лекціями
            </h2>
            
            <div class="d-flex flex-column flex-sm-row gap-3">
                <div class="input-group" style="max-width: 300px; border: 1px solid #ced4da; border-radius: 2px;">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-0 ps-0" placeholder="Шукати..." style="box-shadow: none;">
                </div>
                <select class="form-select text-brand shadow-sm" style="max-width: 150px; border-color: #ced4da; border-radius: 2px;">
                    <option selected>Модуль</option>
                    @if (Model != null)
                    {
                        @foreach (var m in Model)
                        {
                            <option value="@m.Id">Модуль @m.OrderIndex</option>
                        }
                    }
                </select>
            </div>
        </div>

        @* Materials Section Body *@
        <div class="bg-white" style="border-radius: 4px; box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.02); padding: 24px; display: flex; flex-direction: column; gap: 32px;">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info text-center m-0">Матеріали поки що відсутні.</div>
            }
            else
            {
                @foreach (var module in Model)
                {
                    @foreach (var lesson in module.Lessons.OrderBy(l => l.LessonIndex))
                    {
                        <div class="lesson-material-card flex-column flex-md-row text-center text-md-start">
                            
                            <div class="flex-shrink-0 mb-3 mb-md-0">
                                <div class="lesson-thumbnail-frame">
                                    @* Space for future Yulia's frames *@
                                    <span class="text-brand opacity-25">Lesson @lesson.LessonIndex</span>
                                </div>
                            </div>
                            
                            <div class="flex-grow-1">
                                <div class="lesson-meta text-uppercase">
                                    Модуль @module.OrderIndex &bull; Тема @lesson.LessonIndex
                                </div>
                                <h3 class="lesson-title fw-bold">@lesson.Title</h3>
                            </div>
                            
                            <div class="flex-shrink-0 d-flex gap-3 align-items-center mt-3 mt-md-0 justify-content-center">
                                @* Link to specific lesson page *@
                                <a asp-controller="Course" asp-action="Lesson" asp-route-id="@lesson.Id" class="btn btn-outline-brand px-4 py-2" style="text-transform: uppercase; font-size: 0.85rem; text-decoration: none;">
                                    Переглянути
                                </a>
                                @* Link to download module materials *@
                                <a asp-controller="Course" asp-action="DownloadModuleMaterials" asp-route-moduleId="@module.Id" class="btn btn-outline-brand px-3 py-2 d-flex align-items-center justify-content-center">
                                    <i class="bi bi-download" style="font-size: 1.2rem;"></i>
                                </a>
                            </div>
                            
                        </div>
                    }
                }
            }
        </div>
    </div>
</div>

@section Scripts {
}