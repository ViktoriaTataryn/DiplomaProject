@* --- ACTIVE TEST SECTION --- *@
<div class="mt-5">
    <h3>Test Your Knowledge</h3>
    <hr />

    @{
        // Cast the ViewBag data to our specific List
        var questions = ViewBag.Questions as List<diplomaProject.Models.Question>;
    }

    @if (questions != null && questions.Any())
    {
        <form asp-controller="Course" asp-action="CheckHomework" method="post">
            <input type="hidden" name="lessonId" value="@Model.Id" />

            @foreach (var question in questions)
            {
                <div class="card mb-4">
                    <div class="card-header figma-bg-blue text-white">
                        <h5 class="mb-0">@question.Text</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var option in question.Options)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="@(question.IsMultipleChoice ? "checkbox" : "radio")"
                                       name="selectedOptionIds"
                                       value="@option.Id"
                                       id="option_@option.Id">
                                <label class="form-check-label" for="option_@option.Id">
                                    @option.Text
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }

            <button type="submit" class="btn figma-bg-blue text-white w-100 py-2 mt-3">
                SUBMIT TEST
            </button>
        </form>
    }
    else
    {
        <p class="text-muted">No test questions for this lesson yet.</p>
    }
</div> 

@* --- VIKA'S ORIGINAL LESSON CONTENT & RESOURCES (STAYING AS HISTORY) --- *@
@* @model Lesson

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2>@Model.Title</h2>
        </div>
        <div class="card-body">
            <div class="lecture-content">
                <div id="editorjs-content" class="artline-lecture-view"></div>
            </div>

            @if (Model.Resources != null && Model.Resources.Any())
            {
                <div class="lesson-resources mt-5">
                    <h4 class="text-secondary border-bottom pb-2 mb-3">Додаткові матеріали (Зображення)</h4>

                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                        @foreach (var resource in Model.Resources)
                        {
                            <div class="col d-flex justify-content-center">
                                <div class="card h-100 resource-card shadow-sm">
                                    @{
                                        // Перевіряємо розширення файлу
                                        var extension = System.IO.Path.GetExtension(resource.FilePath).ToLower();
                                        var isImage = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" }.Contains(extension);
                                    }

                                    @if (isImage)
                                    {
                                        <img src="@resource.FilePath" class="card-img-top" alt="@resource.FileName" />
                                    }
                                    else
                                    {
                                        <div class="card-img-top d-flex align-items-center justify-content-center bg-light" style="height: 200px;">
                                            <i class="fas fa-file-pdf fa-4x text-danger"></i>
                                        </div>
                                    }

                                    <div class="card-body d-flex flex-column justify-content-between p-3">
                                        <h6 class="card-title text-truncate">@resource.FileName</h6>
                                        <a href="@resource.FilePath" target="_blank" download="@resource.FileName" class="btn btn-outline-primary btn-sm w-100">
                                            <i class="fas fa-download"></i> Завантажити файл
                                        </a> 
                                        <a href="@resource.FilePath" target="_blank" class="btn btn-outline-primary btn-sm w-100">
                                            <i class="fas fa-eye"></i> Переглянути файл
                                        </a>
                                         @if (extension == ".pdf")
                                        {
                                            <a href="@resource.FilePath" target="_blank" class="btn btn-primary btn-sm w-100 mb-2">
                                                <i class="fas fa-file-pdf"></i> Відкрити PDF
                                            </a>
                                        }
                                        else if (extension == ".pptx" || extension == ".docx")
                                        {
                                            <a href="https://view.officeapps.live.com/op/view.aspx?src=@System.Net.WebUtility.UrlEncode(resource.FilePath)"
                                               target="_blank"
                                               class="btn btn-outline-success btn-sm w-100 mb-2">
                                                <i class="fas fa-file-powerpoint"></i> Читати онлайн
                                            </a>
                                        }

                                        <a href="@resource.FilePath" download="@resource.FileName" class="btn btn-light btn-sm w-100">
                                            <i class="fas fa-download"></i> Завантажити файл
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            </div>
            </div>
            </div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Отримуємо JSON дані з моделі.
            // Якщо Content порожній, використовуємо об'єкт з порожнім масивом блоків.
            const rawContent = @Html.Raw(string.IsNullOrEmpty(Model.Content) ? "{\"blocks\":[]}" : Model.Content);
            const container = document.getElementById('editorjs-content');

            if (rawContent && rawContent.blocks) {
                const html = rawContent.blocks.map(block => {
                    switch (block.type) {
                        case 'header':
                            // Витягуємо вирівнювання з tunes (якщо воно є)
                            const headerAlign = block.tunes?.anyTuneName?.alignment || 'left';
                            return `<h${block.data.level} class="fw-bold mt-4 mb-3" style="text-align: ${headerAlign}">
                        ${block.data.text}
                    </h${block.data.level}>`;

                        case 'paragraph':
                            const pAlign = block.tunes?.anyTuneName?.alignment || 'left';
                            return `<p class="mb-3" style="line-height: 1.6; font-size: 1.1rem; text-align: ${pAlign}">
                        ${block.data.text}
                    </p>`;

                        case 'quote':
                            return `<blockquote class="border-start border-4 border-primary ps-3 py-2 my-4 bg-light shadow-sm" style="font-style: italic;">
                        <p class="mb-1">${block.data.text}</p>
                        ${block.data.caption ? `<cite class="small text-muted">— ${block.data.caption}</cite>` : ''}
                    </blockquote>`;

                        case 'image':
                            // const caption = block.data.caption ? `<p class="text-center text-muted small mt-2">${block.data.caption}</p>` : '';
                            // return `<div class="text-center my-4">
                            //             <img src="${block.data.file.url}" class="img-fluid rounded shadow-sm" style="max-height: 500px;" alt="Lesson Image" />
                            //             ${caption}
                            //         </div>`;
                            const caption = block.data.caption ? `<p class="text-center text-muted small mt-2">${block.data.caption}</p>` : '';

                            // 1. Визначаємо розмір на основі активованих екшенів
                            let sizeClass = 'w-100'; // По замовчуванню (на всю ширину)

                            if (block.data.size_small) {
                                sizeClass = 'img-size-small';
                            } else if (block.data.size_medium) {
                                sizeClass = 'img-size-medium';
                            }

                            // 2. Додаємо класи до картинки
                            return `<div class="text-center my-4">
                        <img src="${block.data.file.url}"
                             class="img-fluid rounded shadow-sm ${sizeClass}"
                             alt="Lesson Image" />
                        ${caption}
                    </div>`;

                        case 'list':
                            const listTag = block.data.style === 'ordered' ? 'ol' : 'ul';
                            const items = block.data.items.map(i => `<li class="mb-1">${i}</li>`).join('');
                            return `<${listTag} class="ps-4 mb-3">${items}</${listTag}>`;

                       

                        default:
                            return '';
                    }
                }).join('');

                container.innerHTML = html;
            }
        });
    </script>
}

