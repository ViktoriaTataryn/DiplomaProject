        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); /* Плавне сповільнення */
        position: relative;
        z-index: 1;
    }

    .lesson-body-content .image-tool__image-picture:hover {
        /* Збільшуємо та піднімаємо */
        transform: scale(1.02) translateY(-8px);
        /* Глибока тінь */
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
        /* Виводимо картинку поверх сусідніх елементів */
        z-index: 2;
    }

    .ce-paragraph {
        margin-bottom: 2rem;
        text-align: justify; /* Можна використовувати для "книжкового" вигляду */
        hyphens: auto; /* Автоматичні переноси */
    }

    .disabled-link {
        opacity: 0.5;
        cursor: not-allowed;
        filter: grayscale(1); /* Робимо стрілку сірою */
    }

    .disabled-link a {
        pointer-events: none; /* Вимикаємо кліки */
        text-decoration: none;
    }


