    :root {
        --quiz-primary: #2B31B4;
        --quiz-text: #494C90;
        --quiz-muted: #9799C4;
        --quiz-border: #E0E0E0;
    }

    .quiz-main-title {
        color: var(--quiz-primary);
        font-size: 3rem;
        font-weight: 300;
        margin-bottom: 8px;
        font-family: "Accia Piano";
    }

    .quiz-subtitle {
        font-size: 1.2rem;
        color: #494C90;
        font-family: "Gilroy";
        width:50%;
    }

    /* Прогрес бар */
    .quiz-progress-container {
        position: absolute;
        top: 80px;
        right: 20px;
        width: 270px;
   
        text-align: left;
    }

    .progress-text {
        font-size: 1.2rem;
        color: var(--quiz-muted);
    }

    .quiz-progress-bar {
        height: 8px;
        background:#9799C4;
        margin-top: 5px;
    
    }

    .quiz-progress-fill {
        height: 100%;
        background: var(--quiz-primary);
        transition: width 0.3s ease;
    }

    /* Питання */
    .question-meta {
        font-size: 1rem;
        color: var(--quiz-muted);
        display: block;
        margin-bottom: 5px;
        font-family: "Gilroy";
        font-weight: 300;
    }

    .question-text {
        color: var(--quiz-primary);
        /*  font-weight: bold; */
        font-size: 1.5rem;
        font-family: "Gilroy";
        font-weight: 500;
    }

    /* Контейнер опцій (спільна рамка) */
    .options-container {
        border: 1px solid var(--quiz-border);
        border-radius: 4px;
        overflow: hidden;
    }

    .custom-option-item {
        border-bottom: 1px solid var(--quiz-border);
        position: relative;
    }

        .custom-option-item:last-child {
            border-bottom: none;
        }

    /* Приховуємо стандартний інпут */
    .option-input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
    }

    .option-label {
        display: flex;
        align-items: center;
        padding: 15px 20px;
        cursor: pointer;
        transition: background 0.2s;
        width: 100%;
        margin-bottom: 0;
    }

        .option-label:hover {
            background: #F9FAFF;
        }

    /* Маркер */
    .custom-radio-mark {
        width: 16px;
        height: 16px;
        border: 1px solid var(--quiz-border);
        margin-right: 15px;
        display: inline-block;
        position: relative;
        background: white;
    }

    .option-input:checked + .option-label {
        background: #F4F5FF;
    }

        .option-input:checked + .option-label .custom-radio-mark {
            border-color: var(--quiz-primary);
            background: var(--quiz-primary);
        }

            .option-input:checked + .option-label .custom-radio-mark::after {
                content: "";
                position: absolute;
                width: 6px;
                height: 6px;
                background: white;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }

    /* Кнопка */
    .btn-submit-quiz {
        background: var(--quiz-primary);
        color: white;
        border: none;
        padding: 12px 35px;
        font-size: 1.5rem;
        transition: 0.3s;
        font-family: "Acia Piano";
    }

        .btn-submit-quiz:hover {
            background: #1a1f8c;
            box-shadow: 0 4px 12px rgba(43, 49, 180, 0.2);
        }



    /* Картка завершеного тесту */

    .test-completed-card {
        border-radius: 0;
        border-left: 5px solid #2b31b4;
        background-color: #F8F9FF;
    }
  

    @@media(max-width: 1600px)  {
        html {
            font-size: 14px;
        }
    }
    




