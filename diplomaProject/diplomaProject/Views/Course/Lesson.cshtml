@model diplomaProject.Models.Lesson

@using System.Text.Json
@using System.Linq

<link rel="stylesheet" href="~/css/lesson.css" asp-append-version="true" />

@functions {
    public Microsoft.AspNetCore.Html.IHtmlContent RenderContent(string jsonContent)
    {
        if (string.IsNullOrEmpty(jsonContent)) return Microsoft.AspNetCore.Html.HtmlString.Empty;

        var html = new System.Text.StringBuilder();
        bool firstImageSkipped = false;

        try
        {
            using (JsonDocument doc = JsonDocument.Parse(jsonContent))
            {
                if (doc.RootElement.TryGetProperty("blocks", out var blocks))
                {
                    foreach (var block in blocks.EnumerateArray())
                    {
                        string type = block.GetProperty("type").GetString();
                        var data = block.GetProperty("data");

                        // Пропускаємо першу картинку
                        if (type == "image" && !firstImageSkipped)
                        {
                            firstImageSkipped = true;
                            continue;
                        }

                        if (type == "paragraph")
                        {
                            string text = data.GetProperty("text").GetString();
                            html.Append("<p class='lesson-text'>" + text + "</p>");
                        }
                        else if (type == "header")
                        {
                            
                            int level = data.GetProperty("level").GetInt32();
                            string text = data.GetProperty("text").GetString();

                            // Генеруємо такий самий ID, як у змісті
                            string headerId = "header-" + text.GetHashCode();

                            // Додаємо id до тегу заголовка
                            html.Append($"<h{level} id='{headerId}' class='lesson-header-h2'>{text}</h{level}>");
                          
                           
                            
                        }
                    
                        else if (type == "image")
                        {
                            string url = data.GetProperty("file").GetProperty("url").GetString();

                            // Перевіряємо, чи картинка має бути широкою (горизонтальною)
                            bool isStretched = false;
                            if (data.TryGetProperty("stretched", out var stretchedProp))
                            {
                                isStretched = stretchedProp.GetBoolean();
                            }

                            // Додаємо клас wide-image, якщо картинка розтягнута
                            string containerClass = isStretched
                                ? "lesson-image-container wide-image"
                                : "lesson-image-container";

                            html.Append($"<div class='{containerClass}'>");
                            html.Append($"<img src='{url}' class='img-fluid lesson-img' />");

                            // Додамо підпис до картинки
                            if (data.TryGetProperty("caption", out var imgCaption) && !string.IsNullOrEmpty(imgCaption.GetString()))
                            {
                                html.Append($"<p class='image-caption'>{imgCaption.GetString()}</p>");
                            }

                            html.Append("</div>");
                        }
                        else if (type == "quote")
                        {
                            string text = data.GetProperty("text").GetString();
                            string caption = "";
                            if (data.TryGetProperty("caption", out var cap)) { caption = cap.GetString(); }

                            html.Append("<blockquote class='lesson-quote'><p>«" + text + "»</p>");
                            if (!string.IsNullOrEmpty(caption))
                            {
                                html.Append("<cite>— " + caption + "</cite>");
                            }
                            html.Append("</blockquote>");
                        }
                    }
                }
            }
        }
        catch
        {
            return new Microsoft.AspNetCore.Html.HtmlString("<p class='text-danger'>Помилка рендерингу контенту</p>");
        }

        return new Microsoft.AspNetCore.Html.HtmlString(html.ToString());
    }
}



@{
    ViewData["Title"] = Model.Title;
   
    var headerImage = Model.FirstImageUrl ?? Model.Module?.ImageUrl;
}


<div class="d-flex justify-content-between flex-column gap-0">

<div class="lesson-header-wrapper" >

        <div class="lesson-header-overlay" style="background-image: url('@headerImage');">

        </div>

        <div class="container2">
            @if (Model.TableOfContents.Any())
            {
                <div class=" content-container d-flex flex-column ">
                    <div class="toc-container p-2 py-0">
                        <h5 class="toc-title mb-1">Зміст</h5>
                        <ul class="list-unstyled">
                            @foreach (var item in Model.TableOfContents)
                            {
                                <li class="toc-item level-@item.Level mb-2">
                                    <a href="#header-@item.Text.GetHashCode()" class="toc-link">
                                        @item.Text
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="back-picture justify-content-end">
                        <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1776887206/BG_Profile_Page_qby864.webp" />
                    </div>
                </div>
            }
        </div>

            <div class="lesson-card-info">
              

            <div class="d-flex justify-content-between mb-1 mt-4 align-items-center px-2">
                <!-- ПОПЕРЕДНЯ ЛЕКЦІЯ (Завжди активна, якщо не перша) -->
                @if (ViewBag.PreviousLessonId != null)
                {
                    <a asp-action="Lesson" asp-controller="Course" asp-route-id="@ViewBag.PreviousLessonId"
                       class="d-flex align-items-center text-decoration-none px-2" style="cursor: pointer;">
                        <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646623/scrollLeft_fucspj.svg" class="slider-arrow-img mt-1" alt="scrollLeft"  />
                        <span class="nav-text ms-2">ПОПЕРЕДНЯ ЛЕКЦІЯ</span>
                    </a>
                }
                else
                {
                    <div class="d-flex align-items-center px-2" style="opacity: 0.5;">
                        <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646623/scrollLeft_fucspj.svg" class="slider-arrow-img mt-1" alt="scrollLeft" />
                        <span class="nav-text ms-2">ПОПЕРЕДНЯ ЛЕКЦІЯ</span>
                    </div>
                }

                <span class="module-title">МОДУЛЬ @Model.Module.OrderIndex. ТЕМА @Model.LessonIndex</span>

                <!-- НАСТУПНА ЛЕКЦІЯ (Активна тільки після тесту) -->
                <div class="d-flex px-2">
                    @if (ViewBag.NextLessonId != null)
                    {
                        @if (ViewBag.IsTestCompleted == true || Model.Homeworks == null || !Model.Homeworks.Any())
                        {
                            <a asp-action="Lesson" asp-controller="Course" asp-route-id="@ViewBag.NextLessonId"
                               class="d-flex align-items-center text-decoration-none" style="cursor: pointer;">
                                <span class="nav-text me-2">НАСТУПНА ЛЕКЦІЯ</span>
                                <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646633/scrollRight_guxmdt.svg" class="slider-arrow-img mt-1" alt="scrollRight" />
                            </a>
                        }
                        else
                        {
                            /* Неактивний вигляд (сірий) */
                            <div class="d-flex align-items-center disabled-link"
                                 style="opacity: 0.5; cursor: not-allowed;"
                                 title="Пройдіть тест, щоб відкрити наступну лекцію">
                                <span class="nav-text me-2">НАСТУПНА ЛЕКЦІЯ</span>
                                <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646633/scrollRight_guxmdt.svg" class="slider-arrow-img mt-1" alt="scrollRight" />
                            </div>
                        }
                    }
                </div>
            </div>
                   


                <div class="lesson-meta text-center mt-3 p-2">
                    <span>Модуль @Model.Module.OrderIndex</span> •
                <span>@ViewBag.LessonStatusDisplayName</span>
                </div>

                <h1 class="lesson-main-title text-center mt-3 ">@Model.Title</h1>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="lesson-description text-center mt-4">
                        @Model.Description
                    </p>
                }
            </div>
 
</div>


    <div class="lesson-body-container">
        <div class="lesson-grid-wrapper">
            @Html.Raw(RenderContent(Model.Content))
        </div>
    </div>

    @if (Model.Resources !=null && Model.Resources.Any())
    {

        <div class="res-container px-4">

            <div class="res-list mt-4 py-3">
                <span class="quiz-main-title">Додаткові матеріали</span>
                <ul class="list-unstyled mt-3">
                @foreach (var res in Model.Resources)
                {
                    <li class="res-item level-@res. mb-2">
                          
                            <a asp-action="AdditionalMaterials"
                               asp-controller="Course"
                               asp-route-id="@res.Id"
                               class="res-link">
                                @res.FileName
                            </a>
                    </li>
                }
                </ul>
            </div>

            <div class="res-picture">
                <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1777979100/decor_plants_esqvwm.webp" alt="Alternate Text" />
            </div>

        </div>
    }
    else
    {
        <div class="empty-resources-message text-center">
            Матеріали для цієї лекції поки що відсутні.
        </div>
    }

    @if (Model.Homeworks != null && Model.Homeworks.Any())
{
    <div class=" pt-5  test-container  px-4">

        @{
            var questions = ViewBag.Questions as List<diplomaProject.Models.Question>;
            int totalQuestions = questions?.Count ?? 0;
        }

        

        <h2 class="quiz-main-title">ТЕСТ ДО ЛЕКЦІЇ</h2>
        <p class="quiz-subtitle mb-5">Перевірте своє розуміння матеріалу. Відповідайте на всі питання та натисніть «Завершити тест».</p>
            <div class="quiz-progress-container">
                <span class="progress-text">Питань: @totalQuestions</span>
                <div class="quiz-progress-bar">
                    <div class="quiz-progress-fill" style="width: 100%;"></div>
                </div>
            </div>

        @if (TempData["HomeworkResult"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background-color: #F0F2FF; color: #2b31b4;">
                <strong>Результат тесту:</strong> @TempData["HomeworkResult"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (questions != null && questions.Any())
        {
            @if (ViewBag.IsTestCompleted == true)
            {
                <div class="test-completed-card p-4 shadow-sm text-center">
                    <i class="bi bi-check-circle-fill d-block mb-2" style="font-size: 3rem; color: #2b31b4;"></i>
                        <h5 class="module-title">Ви вже пройшли цей тест!</h5>
                        <p class="mb-0 lesson-description ">Ваш результат: <span class="px-2 py-1" style="background-color: #2b31b4; color:white; font-weight:500;">@ViewBag.CurrentGrade/12</span></p>
                </div>
            }
            else
            {
                <form asp-controller="Course" asp-action="CheckHomework" method="post" class="quiz-form">
                    <input type="hidden" name="lessonId" value="@Model.Id" />
                    <input type="hidden" name="homeworkId" value="@Model.Homeworks.First().Id" />

                    @for (int i = 0; i < questions.Count; i++)
                    {
                        var question = questions[i];
                        <div class="quiz-question-block mb-5">
                            <span class="question-meta">Питання @(i + 1) з @totalQuestions</span>
                            <h5 class="question-text mb-3">@question.Text</h5>

                            <div class="options-container">
                                @foreach (var option in question.Options)
                                {
                                    <div class="custom-option-item">
                                        <input class="option-input"
                                               type="@(question.IsMultipleChoice ? "checkbox" : "radio")"
                                               name="answers[@question.Id]"
                                               value="@option.Id"
                                               id="option_@option.Id">

                                        <label class="option-label" for="option_@option.Id">
                                            <span class="custom-radio-mark"></span>
                                            <span class="option-text-content">@option.Text</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="text-start mt-5">
                        <button type="submit" class="btn-submit-quiz">
                            ЗАВЕРШИТИ ТЕСТ
                        </button>
                    </div>
                </form>
            }
        }
    </div>
}
        else
        {
            <div class="text-center py-5 bg-light rounded-3 mt-4 border-dashed">
                <p class="text-muted mb-0">Тестові питання для цієї лекції знаходяться в розробці.</p>
            </div>
        }
    </div>



@if (TempData["IsTestJustFinished"] != null)
{

    <script>
      
        setTimeout(function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }, 100);
    </script>
}


     
    