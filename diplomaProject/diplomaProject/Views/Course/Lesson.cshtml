<div class="d-flex justify-content-between flex-column gap-5">

<div class="lesson-header-wrapper" >

        <div class="lesson-header-overlay" style="background-image: url('@headerImage');">

        </div>

        <div class="container2">
            @if (Model.TableOfContents.Any())
            {
                <div class=" content-container d-flex flex-column ">
                    <div class="toc-container p-4 ">
                        <h5 class="toc-title mb-3">ЗМІСТ</h5>
                        <ul class="list-unstyled">
                            @foreach (var item in Model.TableOfContents)
                            {
                                <li class="toc-item level-@item.Level mb-2">
                                    <a href="#header-@item.Text.GetHashCode()" class="toc-link">
                                        @item.Text
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="back-picture justify-content-end">
                        <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1776887206/BG_Profile_Page_qby864.webp" />
                    </div>
                </div>
            }
        </div>

            <div class="lesson-card-info">
              

                <div class="d-flex justify-content-between mb-1 mt-4 align-items-center px-3 ">
                    <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646623/scrollLeft_fucspj.svg"
                         class="slider-arrow-img"
                         alt="scrollLeft" />
                         <span class="nav-text">ПОПЕРЕДНЯ ЛЕКЦІЯ</span>
                    <span class="module-title">МОДУЛЬ @Model.Module.OrderIndex. ТЕМА @Model.LessonIndex</span>
                   
                    <span class="nav-text">НАСТУПНА ЛЕКЦІЯ</span>
                    <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646633/scrollRight_guxmdt.svg"
                         class="slider-arrow-img"
                         alt="scrollRight" />
                </div>
                   


                <div class="lesson-meta text-center mt-3 p-2">
                    <span>Модуль @Model.Module.OrderIndex</span> •
                    <span >В процесі</span>
                </div>

                <h1 class="lesson-main-title text-center mt-3">@Model.Title</h1>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="lesson-description text-center mt-3">
                        @Model.Description
                    </p>
                }
            </div>
 
</div>


<div class=" lesson-body-content mt-auto">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            @Html.Raw(RenderContent(Model.Content))
        </div>
    </div>
</div>

