<div class="d-flex justify-content-between flex-column gap-5">
    <div class="lesson-header-wrapper" style="background-image: url('@headerImage');">
        <div class="lesson-header-overlay">
            <div class="container2">

                <div class="lesson-card-info">
                    @* <div class="lesson-nav d-flex justify-content-between align-items-center">
                    <a href="#" class="nav-link-lesson"><i class="bi bi-arrow-left"></i> ПОПЕРЕДНЯ ЛЕКЦІЯ</a>
                    <span class="module-title">МОДУЛЬ @Model.Module.OrderIndex • ТЕМА @Model.LessonIndex</span>
                    <a href="#" class="nav-link-lesson">НАСТУПНА ЛЕКЦІЯ <i class="bi bi-arrow-right"></i></a>
                </div> *@

                    <div class="d-flex justify-content-between mb-1 mt-4 align-items-center px-3">
                        <div class="d-flex align-items-center disabled-link" style="opacity: 0.5;">
                            <img
                                src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646623/scrollLeft_fucspj.svg"
                                class="slider-arrow-img" alt="scrollLeft"/>
                            <span class="nav-text ms-2">ПОПЕРЕДНЯ ЛЕКЦІЯ</span>
                        </div>

                        <span class="module-title">МОДУЛЬ @Model.Module?.OrderIndex. ТЕМА @Model.LessonIndex</span>

                        @if (ViewBag.NextLessonId != null)
                        {
                            // Якщо тест пройдено, або тесту для цієї лекції взагалі немає
                            if (ViewBag.IsTestCompleted == true || Model.Homeworks == null || !Model.Homeworks?.Any())
                            {
                                <a asp-action="Lesson" asp-controller="Course" asp-route-id="@ViewBag.NextLessonId"
                                   class="d-flex align-items-center text-decoration-none" style="cursor: pointer;">
                                    <span class="nav-text me-2">НАСТУПНА ЛЕКЦІЯ</span>
                                    <img
                                        src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646633/scrollRight_guxmdt.svg"
                                        class="slider-arrow-img" alt="scrollRight"/>
                                </a>
                            }
                            else
                            {
                                // Якщо тест ще не пройдено - робимо кнопку сірою
                                <div class="d-flex align-items-center disabled-link"
                                     title="Пройдіть тест, щоб відкрити наступну лекцію">
                                    <span class="nav-text me-2">НАСТУПНА ЛЕКЦІЯ</span>
                                    <img
                                        src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646633/scrollRight_guxmdt.svg"
                                        class="slider-arrow-img" alt="scrollRight"/>
                                </div>
                            }
                        }
                        else
                        {
                            // Якщо це остання лекція в курсі, ховаємо стрілочку
                            <div class="d-flex align-items-center" style="visibility: hidden;">
                                <span class="nav-text me-2">НАСТУПНА ЛЕКЦІЯ</span>
                            </div>
                        }
                    </div>



                    <div class="lesson-meta text-center mt-3 p-2">
                        <span>Модуль @Model.Module?.OrderIndex</span> •
                        <span>В процесі</span>
                    </div>

                    <h1 class="lesson-main-title text-center mt-3">@Model.Title</h1>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="lesson-description text-center mt-3">
                            @Model.Description
                        </p>
                    }
                </div>
                @if (Model.TableOfContents.Any())
                {
                    <div class=" content-container d-flex flex-column ">
                        <div class="toc-container p-4 ">
                            <h5 class="toc-title mb-3">ЗМІСТ</h5>
                            <ul class="list-unstyled">
                                @foreach (var item in Model.TableOfContents)
                                {
                                    <li class="toc-item level-@item.Level mb-2">
                                        <a href="#header-@item.Text.GetHashCode()" class="toc-link">
                                            @item.Text
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="back-picture justify-content-end">
                            <img
                                src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1776887206/BG_Profile_Page_qby864.webp"/>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
