@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Html
@model Lesson

@functions {

    public IHtmlContent RenderContent(string jsonContent)
    {
        if (string.IsNullOrEmpty(jsonContent)) return HtmlString.Empty;

        var html = new StringBuilder();
        var firstImageSkipped = false;

        try
        {
            using (var doc = JsonDocument.Parse(jsonContent))
            {
                if (doc.RootElement.TryGetProperty("blocks", out var blocks))
                {
                    foreach (var block in blocks.EnumerateArray())
                    {
                        var type = block.GetProperty("type").GetString();
                        var data = block.GetProperty("data");

                        // Пропускаємо першу картинку
                        if (type == "image" && !firstImageSkipped)
                        {
                            firstImageSkipped = true;
                            continue;
                        }

                        if (type == "paragraph")
                        {
                            var text = data.GetProperty("text").GetString();
                            html.Append("<p class='lesson-text'>" + text + "</p>");
                        }
                        else if (type == "header")
                        {
                            var level = data.GetProperty("level").GetInt32();
                            var text = data.GetProperty("text").GetString();
                            html.Append("<h" + level + " class='lesson-header-h2'>" + text + "</h" + level + ">");
                        }
                        else if (type == "image")
                        {
                            var url = data.GetProperty("file").GetProperty("url").GetString();
                            html.Append("<div class='lesson-image-container text-center mb-4'>");
                            html.Append("<img src='" + url + "' class='img-fluid lesson-img' />");
                            html.Append("</div>");
                        }
                        else if (type == "quote")
                        {
                            var text = data.GetProperty("text").GetString();
                            var caption = "";
                            if (data.TryGetProperty("caption", out var cap))
                            {
                                caption = cap.GetString();
                            }

                            html.Append("<blockquote class='lesson-quote'><p>«" + text + "»</p>");
                            if (!string.IsNullOrEmpty(caption))
                            {
                                html.Append("<cite>— " + caption + "</cite>");
                            }

                            html.Append("</blockquote>");
                        }
                    }
                }
            }
        }
        catch
        {
            return new HtmlString("<p class='text-danger'>Помилка рендерингу контенту</p>");
        }

        return new HtmlString(html.ToString());
    }

}



