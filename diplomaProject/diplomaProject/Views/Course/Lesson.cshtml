@model Lesson

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2>@Model.Title</h2>
        </div>
        <div class="card-body">
            <div class="lesson-content mb-4">
                @Html.Raw(Model.Content)
            </div>

            @if (Model.Resources != null && Model.Resources.Any())
            {
                <div class="lesson-resources mt-5">
                    <h4 class="text-secondary border-bottom pb-2 mb-3">Додаткові матеріали (Зображення)</h4>

                    <div class="row row-cols-1 row-cols-md-2 g-4">
                        @foreach (var resource in Model.Resources)
                        {
                            <div class="col">
                                <div class="card h-100 resource-card">
                                    <img src="@resource.FilePath" class="card-img-top img-fluid" alt="@resource.FileName" />

                                    <div class="card-body text-center p-2">
                                        <small class="text-muted">@resource.FileName</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

           @*   @if (Model.Quiz != null)
             {
                 <div class="mt-5 text-center">
                     <a asp-action="TakeQuiz" asp-route-lessonId="@Model.Id" class="btn btn-success btn-lg">
                         <i class="fas fa-file-alt"></i> Пройти тест до лекції
                     </a>
                 </div>
             } *@
        </div>
    </div>
</div>

<style>
    .lesson-content {
        font-size: 1.1rem;
        line-height: 1.7;
    }
    .resource-card {
        border: none;
        transition: transform 0.2s;
    }
    .resource-card:hover {
        transform: scale(1.02);
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .card-img-top {
        object-fit: contain; /* Картинка не обрізається, а вписується */
        max-height: 300px; /* Обмежуємо висоту, щоб не було гігантських картинок */
        background-color: #f8f9fa; /* Фон для прозорих картинок */
    }
</style>