<style>
    /* Головний контейнер контенту */
    .lecture-content {
        font-size: 1.1rem;
        line-height: 1.7;
        word-wrap: break-word;
    }

        /* Специфічне обмеження для всіх картинок всередині тексту лекції */
        .lecture-content img {
            max-width: 100% !important; /* Не дає вийти за межі екрану */
            height: auto !important; /* Зберігає пропорції */
            display: block;
            margin: 2rem auto; /* Центрує і дає відступи */
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        /* Обмежуємо максимальну висоту, щоб картинка не займала три екрани */
        .lecture-content img {
            max-height: 600px;
            object-fit: contain;
        }

    /* Стилі для сітки додаткових матеріалів */
    .resource-card {
        max-width: 350px; /* Обмежуємо максимальну ширину самої картки */
        margin: 0 auto; /* Центруємо картку в колонці */
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        overflow: hidden;
    }

        .resource-card .card-img-top {
            height: 200px; /* Фіксована висота */
            width: 100%;
            object-fit: contain; /* КЛЮЧОВЕ: картинка вписується, а не розтягується */
            background-color: #f8f9fa; /* Світлий фон для пустих місць з боків */
            padding: 10px; /* Невеликий відступ, щоб картинка не торкалася країв */
        }

        /* Якщо це іконка (PDF) */
        .resource-card .bg-light {
            background-color: #f1f3f5 !important;
        }

        /* Робимо заголовок файлу красивим */
        .resource-card .card-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: #495057;
        }
</style> 