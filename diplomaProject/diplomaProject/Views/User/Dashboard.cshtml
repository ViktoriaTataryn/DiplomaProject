@using System.Globalization
@model diplomaProject.DTOs.DashboardViewDto

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true"/>

<div class=" d-flex justify-content-between welcome-section mb-3">
    <div class="welcome-text ">
        <div class="title d-none d-md-block">Раді бачити вас на платформі ARTLINE</div>
        <div class="title d-block d-md-none">ВІТАЄМО на платформі ARTLINE!</div>
        <div class="mt-3 subtitle">Нижче - ваш поточний прогрес у курсі</div>
        <div class="subtitle">«@Model.CourseTitle».</div>
    </div>
    <div class="welcome-picture">
        <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1776072847/BG_fbakmk.webp" alt="background"/>
    </div>
</div>

<div class="m-3">
    <div class=" d-flex " id="progressContainer">
      
        <div class="col-12 progress-inner-content px-3 py-4">
            <span class="title mb-2 mt-4 ">ПРОГРЕС КУРСУ </span>

            @* Контейнер для всього прогресу *@
            <div class="progress-timeline-container mt-3">

                <div class="statue-avatar-container is-hidden">
                    <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1776075828/Progress_Avatar_fri9bd.png"
                         class="statue-img" alt="Статус курсу"/>
                </div>

                @* Рядок із сегментами модулів *@
                <div class="progress-segments d-flex align-items-end">


                    @foreach (var module in Model.Progress!.ModuleProgress)
                    {
                        var isCompleted = module.Status == "Completed";
                        var isInProgress = module.Status == "InProgress";

                        @* Сегмент прогрес-бару для одного модуля *@
                        <div class="progress-segment-wrapper flex-grow-1 mx-3 pos-relative">

                            @* Сама смужка сегмента *@
                            <div class="progress-line @(isCompleted ? "is-completed" : "")"></div>

                            @* Якщо модуль в процесі — показуємо над ним фігурку статуї *@
                            @if (isInProgress)
                            {
                                <div class="statue-avatar-container text-center">
                                    <img
                                        src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1776075828/Progress_Avatar_fri9bd.png"
                                        class="statue-img" alt="Ви тут"/>
                                </div>
                            }


                        </div>
                    }
                </div>
            </div>


            <p class="small-text">
                Пройдено: @Model.Progress.CompletedModule з @Model.Progress.TotalModule модулів
            </p>
            @if (Model.Progress.CurrentLesson != null)
            {
                <p class="hometask-text"> Поточний урок: @Model.Progress.CurrentLesson.Title</p>
            }
            else
            {
                <h2>Немає активної лекції</h2>
            }

            <p class="hometask-text"> Наступний урок: @Model.Progress.NextLessonTitle</p>

            <div class="m-3 mt-4 buy-button">
                @if (Model.IsPaid)
                {
                    @* Стан 3: Курс оплачено *@
                    <a href="@Url.Action("Index", "Course")" class="d-block btn-text">
                        ПРОДОВЖИТИ НАВЧАННЯ
                    </a>
                }
                else if (Model.FirstModuleCompleted)
                {
                    @* Стан 2: Модуль 1 пройдено, потрібна оплата *@
                    <button href="@Url.Action("CreateCheckoutSession", "Payment", new { courseId = Model.CourseId })"
                            class="d-block btn-text" id="buyButton">
                        ПЕРЕЙТИ ДО ОПЛАТИ
                    </button>
                }
                else if (!Model.HasStarted)
                {
                    @* Стан 1: Новий користувач *@
                    <a href="@Url.Action("Index", "Course")" class="d-block btn-text">
                        РОЗПОЧАТИ НАВЧАННЯ
                    </a>
                }
                else
                {
                    var lessonId = Model.Progress?.CurrentLesson?.Id;

                    if (lessonId != null)
                    {
                        <a href="@Url.Action("Lesson", "Course", new { id = lessonId })" class="d-block btn-text">
                            ПРОДОВЖИТИ НАВЧАННЯ
                        </a>
                    }
                    else
                    {
                        @* Запасний варіант: якщо поточної лекції немає, ведемо на загальну сторінку курсу *@
                        <a href="@Url.Action("Index", "Course")" class="d-block btn-text">
                            ПРОДОВЖИТИ НАВЧАННЯ
                        </a>
                    }
                }
            </div>
        </div>


    </div>


    <div class=" d-flex justify-content-between mb-1 mt-1 py-4 " id="conteiner2">

        <div class="py-4 px-3 " id="hometask">
            <span class="title">ДОМАШНІ ЗАВДАННЯ</span>

            <div class=" d-flex  justify-content-sm-evenly align-content-center gap-3 p-3 mt-3">
                <div class="d-flex flex-column px-4 hometask-box" style="border-right: 2px solid #8588D1; ">
                    <span class="hometask-text">Доступних завдань:</span>
                    <span class="hometask-num">@Model.HomeworkStats?.AvailableWork</span>
                </div>

                <div class="d-flex flex-column  px-4 hometask-box " style="border-right: 2px solid #8588D1">
                    <span class="hometask-text">Завдань виконано:</span>
                    <span class="hometask-num">@Model.HomeworkStats?.Completed</span>
                </div>

                <div class="d-flex flex-column  px-4 hometask-box ">
                    <span class="hometask-text">Завдань залишилось:</span>
                    <span class="hometask-num">@Model.HomeworkStats?.Remaining</span>
                </div>
            </div>
        </div>

        <div class="py-4 px-3 " id="grades">
            <span class="title">ОЦІНКИ</span>

             <div class=" d-flex  justify-content-between align-content-center gap-3 p-2 mt-3">

                <div class="px-1 flex-grow-1" style="border-right: 2px solid #8588D1 !important; min-width: 150px;">

                    @if (!Model.Grades.Any())
                    {
                        <span class="small-text" style="display: block;">Поки немає оцінок</span>
                    }
                    else
                    {
                        <div class="grade-list-scroll">
                            @* Початок контейнера з прокруткою *@
                            @{
                                var groupedGrades = Model.Grades
                                .GroupBy(g => g.Date.ToString("MMMM", new System.Globalization.CultureInfo("uk-UA")))
                                .ToList();
                            }

                            @foreach (var group in groupedGrades)
                            {
                                <div class="grade-item-container">
                                    <span>@group.Key</span>
                                    <div class="grades-grid">
                                        @foreach (var grade in group)
                                        {
                                            <div class="grade-square">@grade.Value</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div> @* Кінець контейнера з прокруткою *@
                    }
                </div>
                <div class="d-flex flex-column px-4  hometask-box">
                    <span class="hometask-text">Середній бал:</span>
                    <span
                        class="hometask-num">@(Model.Grades.Any() ? Model.Grades.Average(g => g.Value).ToString("F1") : "0")</span>
                </div>
            </div>
        </div>
    </div>


    <div class=" mb-3 mt-1 py-3 px-3" id="modulesList">
        <div class="d-flex justify-content-between mb-2 mt-2 pt-2 align-items-center ">
            <span class="title">МОДУЛІ КУРСУ</span>

            <a asp-controller="Course" asp-action="Index"
               class=" module-item-container text-decoration-none ">
                <span class="title"
                      style="font-size:19px; letter-spacing:0; line-height: 1; ">ПЕРЕГЛЯНУТИ ДЕТАЛЬНІШЕ</span>

            </a>

        </div>

        <div class="d-flex justify-content-between mb-1 mt-4 align-items-center px-3 ">
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646623/scrollLeft_fucspj.svg"

                 class="slider-arrow-img"
                 onclick="scrollSlider(-1)"
                 alt="scrollLeft"/>
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646633/scrollRight_guxmdt.svg"

                 class="slider-arrow-img"
                 onclick="scrollSlider(1)"
                 alt="scrollRight"/>
        </div>


        <div class="slider-container">

            <div class="slider-wrapper" id="modulesSlider">
                @foreach (var module in Model.Progress!.ModuleProgress)
                {
                    <div class="slider-item mb-0">


                        @if (module.Status == "Close")
                        {
                            <div style="cursor: not-allowed; ">

                                <partial name="_ModuleCard" model="module"/>
                            </div>
                       
                        }
                        else
                        {
                            <a asp-controller="Course" asp-action="Index"
                               asp-route-id="@module.ModuleId"
                               class=" module-item-container text-decoration-none d-block">
                                <partial name="_ModuleCard" model="module"/>
                            </a>
                          
                        }
                    </div>

                }
            </div>


        </div>


    </div>
</div>



@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const buyButton = document.getElementById('buyButton');

            if (buyButton) {
                buyButton.addEventListener('click', async function () {
                    // Вимикаємо кнопку, щоб уникнути повторних кліків
                    buyButton.disabled = true;
                    buyButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Обробка...';

                    try {

                        const courseId = "@Model.Progress.CourseId";
                        console.log("Курс ID для оплати:", courseId);


                        const response = await fetch(`/api/Payment/create-checkout-session?courseId=${courseId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });

                        if (!response.ok) {
                            throw new Error('Помилка мережі або сервера');
                        }

                        const data = await response.json();

                        if (data.url) {
                            // Перенаправлення на сторінку Stripe
                            window.location.href = data.url;
                        } else {
                            alert('Не вдалося отримати посилання на оплату.');
                            resetButton();
                        }

                    } catch (error) {
                        console.error('Error:', error);
                        alert('Сталася помилка при з’єднанні зі Stripe. Перевірте консоль.');
                        resetButton();
                    }
                });
            }

            function resetButton() {
                buyButton.disabled = false;
                buyButton.innerHTML = 'Придбати повний доступ';
            }
        });

        function scrollSlider(direction) {

            const slider = document.getElementById('modulesSlider');

            if (slider) {
                const itemWidth = 280; // ширина картки + gap
                slider.scrollBy({
                    left: direction * itemWidth,
                    behavior: 'smooth'
                });
            } else {
                console.error("Елемент modulesSlider не знайдено!");
            }
        }
    </script>
}






