@model diplomaProject.DTOs.DashboardViewDTO


<div class="container py-4">
    <h4 class="mb-4">Навчальна платформа</h4>
    <h5 class="mb-4">Прогрес курсу </h5>
    <p class="text-muted small">
        Пройдено: @Model.Progress.CompletedModule з @Model.Progress.TotalModule
    </p>
    @if (string.IsNullOrEmpty(Model.Progress.CurrentLesson) || Model.Progress.CurrentLesson == "Немає активної лекції")
    {
        <div class="alert alert-light border-0 p-0 mb-0">
            <p class="text-muted mb-0">
                <i class="fas fa-info-circle text-info me-2"></i>
                Наразі у вас **немає активної лекції**. Оберіть модуль нижче, щоб розпочати навчання.
            </p>
        </div>
    }
    else
    {
        <p class="text-muted small">
            <i class="fas fa-play-circle text-primary me-2">
            Поточний урок:  @Model.Progress.CurrentLesson</i>
        </p>
       
    }


    <div class="row justify-content-center">
        @* Центруємо контент *@
        <div class="col-md-8 col-lg-6 col-sm-10">

            <h5 class="mb-4">Модулі курсу</h5>
<div class="accordion shadow-sm" id="moduleAccordion">
    @foreach (var module in Model.Progress.ModuleProgress)

    {
        <div class="accordion-item mb-3 border-0 shadow-sm rounded">
           
           @*  <h2 class="accordion-header" id="heading-@module.ModuleId">
                <button class="accordion-button collapsed py-4" type="button"
                        data-bs-toggle="collapse" data-bs-target="#collapse-@module.ModuleId">
                    <div class="d-flex justify-content-between w-100 align-items-center pe-3">
                        <span>
                            <i class="fas fa-layer-group me-3 text-primary"></i>
                            Модуль @module.ModuleNumber
                        </span>
                        <span>
                            <i class="fas fa-layer-group me-3 text-primary"></i>
                            <strong>@module.Name</strong>
                        </span>
                        <span>
                            <i class="fas fa-layer-group me-3 text-primary"></i>
                            Пройдено @module.Percent%
                        </span>
                       
                    </div>
                </button>
            </h2>
            *@

            <h2 class="accordion-header" id="heading-@module.ModuleId">
                <button class="accordion-button collapsed p-0 overflow-hidden" type="button"
                        data-bs-toggle="collapse" data-bs-target="#collapse-@module.ModuleId"
                        style="display: block;">
                    @* Важливо: display: block, щоб картинка була зверху *@

                    <div class="module-card-image" style="height: 160px; width: 100%; overflow: hidden;">
                        @if (!string.IsNullOrEmpty(module.ImageForUser))

                        {
                            <img src="@module.ImageForUser" class="w-100 h-100" style="object-fit: cover;" alt="@module.Name" />
                        }

                        else

                        {
                            <div class="bg-light w-100 h-100 d-flex align-items-center justify-content-center">
                                <i class="fas fa-image fa-3x text-muted"></i>
                            </div>
                        }
                    </div>

                    <div class="p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary-soft text-primary">
                                <i class="fas fa-layer-group me-1"></i> Модуль @module.ModuleNumber
                            </span>
                                        @* <span class="text-muted small">
                                            <i class="fas fa-chart-line me-1"></i> @module.Status
                                        </span> *@
                                        <span class="text-muted small">
                                            <i class="fas fa-chart-line me-1"></i>
                                          
                                            @if (module.Status == "Completed")
                                            {
                                                <span class="text-success">Пройдено</span>
                                            }
                                            else if (module.Status == "InProgress")
                                            {
                                                <span class="text-warning">У процесі</span>
                                            }
                                            else if (module.Status == "Open")
                                            {
                                                <span class="text-primary">Відкрито</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger"><i class="fas fa-lock me-1"></i> Заблоковано</span>
                                            }
                                        </span>
                            <span class="text-muted small">
                                <i class="fas fa-chart-line me-1"></i> Пройдено @module.Percent%
                            </span>
                        </div>

                        <h5 class="fw-bold mb-0 text-dark">@module.Name</h5>

                        <div class="progress mt-2" style="height: 6px;">
                            <div class="progress-bar bg-success" role="progressbar"
                                 style="width: @module.Percent %" aria-valuenow="@module.Percent"
                                 aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </button>
            </h2>
        

        </div>
    }
</div>
</div>
</div>
</div>
