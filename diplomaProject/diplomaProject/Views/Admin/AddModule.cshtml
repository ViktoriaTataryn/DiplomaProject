@model diplomaProject.DTOs.CreateModuleDTO

<form asp-action="AddModule" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label>Назва модуля</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Номер модуля</label>
        <input asp-for="OrderIndex" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Опис модуля</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Обкладинка модуля</label>
        <input type="file" asp-for="imageFile" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-primary">Створити модуль</button>
</form>
