@model diplomaProject.DTOs.UpdateLessonDTO
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Редагування лекції";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4>Редагування лекції: @Model.Title</h4>
        </div>
        <div class="card-body">
            <form asp-action="UpdateLesson" id="editLessonForm" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-control-label">Назва лекції</label>
                    <input asp-for="Title" class="form-control" placeholder="Введіть назву..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label>Оберіть модуль</label>
                    <select asp-for="ModuleId" class="form-control" asp-items="ViewBag.Modules">
                        <option value="">-- Оберіть модуль --</option>
                    </select>
                    <span asp-validation-for="ModuleId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-control-label">Опис лекції</label>
                    <input asp-for="Description" class="form-control" placeholder="Введіть опис..." />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <label class="form-control-label">Контент лекції</label>
                <div id="editorjs" class="border rounded bg-white p-3 mb-3" style="min-height: 400px;"></div>
                <input type="hidden" asp-for="Content" id="contentHiddenInput" />

                <div class="mb-4">
                    <label class="form-control-label"><strong>Поточні додаткові матеріали:</strong></label>

                    @if (Model.ExistingResources != null && Model.ExistingResources.Any())
                    {
                        <div class="list-group mt-2">
                            @foreach (var resource in Model.ExistingResources)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-file-alt text-primary me-2"></i>
                                        <a href="@resource.FilePath" target="_blank" class="text-decoration-none">
                                            @resource.FileName
                                        </a>
                                    </div>

                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            onclick="deleteResource(@resource.Id, this)">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">Додаткових матеріалів поки немає.</p>
                    }
                </div>

                <div class="mb-4">
                    <label class="form-control-label">Додати нові матеріали (Зображення/PDF)</label>
                    <input type="file" name="NewResources" class="form-control" multiple />
                    <small class="text-muted">Ви можете обрати кілька файлів одночасно.</small>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="GetLessons" class="btn btn-secondary">Назад до списку</a>
                    <button type="submit" class="btn btn-success">Зберегти зміни</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/editorjs@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/header@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/list@@1.8.0"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/image@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/audio@@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/quote@latest"></script>

    <script>
        const initialData = @Html.Raw(string.IsNullOrEmpty(Model.Content) ? "{\"blocks\":[]}" : Model.Content);

        const editor = new EditorJS({
            holder: 'editorjs',
            placeholder: 'Продовжуйте редагування лекції...',
            data: initialData,
            tools: {
                header: {
                    class: Header,
                    inlineToolbar: ['link'],
                },
                quote: {
                    class: Quote,
                    inlineToolbar: true,
                    config: {
                        quotePlaceholder: 'Введіть цитату',
                        captionPlaceholder: 'Автор цитати',
                    },
                },
                list: {
                    class: List,
                    inlineToolbar: true
                },
                image: {
                    class: ImageTool,
                    config: {
                        endpoints: {
                            byFile: '/AdminLesson/UploadImage'
                        },
                        field: 'file'
                    }
                }
            }
        });

        const editForm = document.getElementById('editLessonForm');
        editForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            try {
                const savedData = await editor.save();
                const contentInput = document.getElementById('contentHiddenInput');
                contentInput.value = JSON.stringify(savedData);
                editForm.submit();
            } catch (error) {
                console.error('Помилка при збереженні контенту:', error);
                alert('Сталася помилка при спробі зберегти контент лекції.');
            }
        });

        function deleteResource(id, btn) {
            if (confirm('Видалити цей файл?')) {
                // Тут логіка видалення через fetch, якщо потрібно
                btn.closest('.list-group-item').remove();
            }
        }
    </script>
}