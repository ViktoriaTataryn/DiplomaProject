@model RegisterViewModel
@{
    ViewData["Title"] = "Реєстрація";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-4 col-sm-6 mt-4">
        <div class="card border-0 p-4 bg-transparent">
            <div class="card-body p-0">
                <h2 class="text-center mb-5 figma-title">СТВОРИТИ АКАУНТ</h2>

                <form asp-action="Register" method="post">
                    <input type="hidden" name="courseId" value="3"/>
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-4">
                        <div class="figma-input-wrapper">
                            <input asp-for="FirstName" class="figma-input" placeholder="Ім'я"/>
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <div class="figma-input-wrapper">
                            <input asp-for="LastName" class="figma-input" placeholder="Прізвище"/>
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <div class="figma-input-wrapper">
                            <input asp-for="Email" class="figma-input" placeholder="E-mail"/>
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <div class="figma-input-wrapper">
                            <input asp-for="Password" type="password" id="passInput" class="figma-input"
                                   placeholder="Пароль"/>
                            <button type="button" class="figma-eye-btn" id="togglePass">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                                     class="bi bi-eye" viewBox="0 0 16 16">
                                    <path
                                        d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                    <path
                                        d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-5">
                        <div class="figma-input-wrapper">
                            <input asp-for="ConfirmPassword" type="password" id="confirmPassInput" class="figma-input"
                                   placeholder="Підтвердження пароля"/>
                            <button type="button" class="figma-eye-btn" id="toggleConfirmPass">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                                     class="bi bi-eye" viewBox="0 0 16 16">
                                    <path
                                        d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                    <path
                                        d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-lg w-100 mb-4 figma-bg-blue">
                        ЗАРЕЄСТРУВАТИСЯ
                    </button>
                </form>

                <p class="text-center mb-0 figma-text-blue" style="font-size: 0.95rem;">
                    Вже маєте акаунт? <a asp-action="Login" class="figma-text-blue fw-bold text-decoration-none"
                                         style="border-bottom: 1.5px solid #2B31B4; padding-bottom: 1px;">Увійти</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleVisibility(inputId) {
            const input = document.getElementById(inputId);
            if (input.type === "password") {
                input.type = "text";
            } else {
                input.type = "password";
            }
        }

        document.getElementById('togglePass').addEventListener('click', function () {
            toggleVisibility('passInput');
        });
        document.getElementById('toggleConfirmPass').addEventListener('click', function () {
            toggleVisibility('confirmPassInput');
        });
    </script>
}