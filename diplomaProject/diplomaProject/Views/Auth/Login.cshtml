@model diplomaProject.Models.LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 p-4" style="border-radius: 15px;">
            <div class="card-body">
                <h2 class="text-center mb-4">Welcome Back</h2>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <input asp-for="Email" class="form-control form-control-lg" style="border-radius: 10px;" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg" style="border-radius: 10px;" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label class="form-check-label">Remember my login</label>
                    </div>

                    <button type="submit" class="btn btn-dark btn-lg w-100 mb-3" style="border-radius: 10px; background-color: #000;">
                        Log In
                    </button>
                </form>

                <p class="text-center mb-0">
                    New student? <a asp-action="Register" class="text-decoration-none fw-bold" style="color: #000;">Create account</a>
                </p>
            </div>
        </div>
    </div>
</div>