<script>
    // const collapseElement = document.getElementById('fullProgram');
    // const btn = document.querySelector('.show-more-btn');

    // collapseElement.addEventListener('shown.bs.collapse', function () {
    //     btn.innerHTML = 'ЗГОРНУТИ ПРОГРАМУ';
    // });

    // collapseElement.addEventListener('hidden.bs.collapse', function () {
    //     btn.innerHTML = 'ПОКАЗАТИ УСЮ ПРОГРАМУ';
    // });
    document.addEventListener("DOMContentLoaded", function () {
        const collapseElement = document.getElementById('fullProgram');
         const btn = document.querySelector('.show-more-btn');
        const fullProgram = document.getElementById('fullProgram');
      
        const decorationImg = document.querySelector('.basket-img');
        const programSection = document.querySelector('.program-section');

        fullProgram.addEventListener('show.bs.collapse', function () {
            // Ховаємо картинку
            btn.innerHTML = 'ЗГОРНУТИ ПРОГРАМУ';
            if (decorationImg) decorationImg.classList.add('img-hidden');
          
            programSection.classList.add('program-expanded');
        });

        fullProgram.addEventListener('hide.bs.collapse', function () {
            btn.innerHTML = 'ПОКАЗАТИ УСЮ ПРОГРАМУ';
            // Повертаємо картинку, коли програма згортається
            if (decorationImg) decorationImg.classList.remove('img-hidden');
            programSection.classList.remove('program-expanded');
        });
    });

    function scrollSlider(direction) {
        const slider = document.getElementById('reviewsSlider');
        if (!slider) {
            console.error("Слайдер reviewsSlider не знайдено!");
            return;
        }

        // Беремо першу ліпшу картку всередині слайдера
        const firstItem = slider.querySelector('.review-card-container');

        if (firstItem) {
            // Вираховуємо ширину картки + відступ (gap)
            const scrollAmount = firstItem.offsetWidth + 20;

            slider.scrollBy({
                left: direction * scrollAmount,
                behavior: 'smooth'
            });

           
        } else {
            console.error("Картки .review-card-container не знайдені всередині слайдера!");
        }
    }
    function scrollAuthorsSlider(direction) {
        const slider = document.getElementById('authorsSlider');
        if (!slider) return;

        // Визначаємо ширину однієї картки разом із її зовнішніми відступами
        const card = slider.querySelector('.mini-container');
        if (!card) return;

        const cardWidth = card.getBoundingClientRect().width + 20; // 20 — це margin-right

    
        slider.scrollBy({
            left: direction * cardWidth,
            behavior: 'smooth'
        });
    }
</script>

