/* 1. Визначаємо анімацію (вертикальний рух) */
@@keyframes float {
    0% {
        transform: translateY(0px); /* Початкова позиція */
    }
    50% {
        transform: translateY(-10px); /* Піднімається на 10px вгору */
    }
    100% {
        transform: translateY(0px); /* Повертається назад */
    }
}
@@keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-15px); } /* Піднімається на 15px */
    100% { transform: translateY(0px); }
}

/* Анімація №2: Погойдування (Sway) - нахил навколо центру */
@@keyframes sway {
    0% { transform: rotate(-1.5deg); } /* Легкий нахил вліво */
    50% { transform: rotate(1.5deg); } /* Легкий нахил вправо */
    100% { transform: rotate(-1.5deg); }
}






