@model diplomaProject.DTOs.LandingDto
@{
    Layout = "_LandingLayout";
    var allModules = Model.Modules;

    var visibleModules = allModules.Take(3).ToList();
    var hiddenModules = allModules.Skip(3).ToList();
}
<link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Monsieur+La+Doulaise&display=swap" rel="stylesheet">

<div style="margin-bottom:0px;padding-bottom:0px;">
    <div class="container1 ">
        <div class="up-img">
            <img
                src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407388/Hero_Decorative_Plants_jzt3xj.webp"/>
        </div>
        <div class="mermaid-img">
            <img
                src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407446/Hero-Decorative-Mermaid_cm9et7.webp"/>
        </div>
        <div class="plane-img">
            <img
                src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407504/Hero-Decorative-Hang-Glider_lvnmtx.webp"/>
        </div>
        <div class="bird-img">
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407512/Hero_Decorative_Bird_cxty3x.webp"/>
        </div>
        <div class="d-flex flex-column align-items-center">
            <div class="avatar-img">
                <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1776075828/Progress_Avatar_fri9bd.png"/>
            </div>
            <span class="main-title">Artline</span>
            <span class="sub-title"><br/>Онлайн-курс з історії мистецтва:<br/> від античності до сучасності</span>
        </div>

        <div class="circle-img">
            <img
                src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407479/Hero-Decorative-Sphere_myrtmu.webp"/>
        </div>
        <div class="column-img">
            <img
                src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407380/Hero_Decorative_Column_aexzz5.webp"/>
        </div>
        <div class="down-img">
            <img
                src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407345/Hero-Decorative-Ground_qibdbo.webp"/>
        </div>
    </div>


    <div class="container2 " id="container2">
        <div class="row align-items-start">
            <div class="row align-items-start">

                <div class="col-lg-4 p-3 m-3 ">
                    <div class="text-content d-flex flex-column ">
                        <div class="landing-title mt-4">ПРО КУРС</div>
                        <div class="landing-subtitle ">Цей курс присвячений історії мистецтва як цілісному процесу.
                        </div>
                        <div class="ordinary-text ">
                            Ми розглядаємо мистецтво не ізольовано, а в широкому культурному контексті: історичному,
                            соціальному та філософському.
                        </div>
                        <div class="ordinary-text wide-text">
                            Програма охоплює ключові періоди розвитку мистецтва та різні види: живопис, скульптуру,
                            архітектуру, музику і кіно. Матеріал подано структуровано, з опорою на візуальні приклади,
                            порівняння та аналітичні пояснення.<br/><br/>
                            Курс підходить як для першого знайомства з темою, так і для систематизації вже наявних
                            знань.
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="gallery-relative-container">
                        <div class="gallery-grid">
                            <div class="gallery-item item-high">
                                <div class="wire wire-left"></div>
                                <div class="wire wire-right"></div>
                                <div class="picture-frame ">
                                    <img
                                        src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778503947/Girl_ruricr.webp"
                                        alt="Art 1">
                                </div>
                                <div class="picture-caption">
                                    <span class="title">Дівчина з перловою сережкою</span>
                                </div>
                            </div>

                            <div class="gallery-item item-low">
                                <div class="wire wire-left"></div>
                                <div class="wire wire-right"></div>
                                <div class="picture-frame ">
                                    <img
                                        src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778503955/Hitchcock_e1o8lp.webp"
                                        alt="Art 2">
                                </div>
                                <div class="picture-caption">
                                    <span class="title">Альфред Гічкок</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="container3">
        <div class="p-3 m-3">
            <div class="landing-title mt-4">ДЛЯ КОГО ЦЕЙ КУРС</div>
            <div class="plane-img" style=" transform: scaleX(-1)">
                <img
                    src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407504/Hero-Decorative-Hang-Glider_lvnmtx.webp"/>
            </div>
        </div>
        <div class="row section-row">
            <div class="col-lg-4 p-3 mini-container">
                <div class="landing-subtitle ">Всіх, хто цікавиться мистецтвом</div>
                <div class="ordinary-text ">
                    Для тих, хто хоче розібратись в історії мистецтва з нуля і зрозуміти, як пов’язані між собою різні
                    періоди та напрями.
                    Ви отримаєте цілісну картину розвитку мистецтва без перевантаження термінами.
                </div>
            </div>
            <div class="col-lg-4 p-3 mini-container">
                <div class="landing-subtitle ">Дизайнерів і креативників</div>
                <div class="ordinary-text ">
                    Для тих, хто працює з візуальною мовою і хоче краще розуміти її походження.  Курс допоможе розширити
                    візуальний кругозір і усвідомлено працювати з формою, стилем і композицією.
                </div>
            </div>
            <div class="col-lg-4 p-3 mini-container">
                <div class="landing-subtitle ">Студентів гуманітарних спеціальностей</div>
                <div class="ordinary-text ">
                    Для тих, кому потрібна чітка структура знань для навчання або підготовки до іспитів.  Матеріали
                    курсу можна використовувати як базу для подальшого вивчення теми.
                </div>
            </div>
        </div>
    </div>

    <div class="container4 p-0 m-0 " id="container4">
        <div class="plants-img d-flex justify-content-end ">
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407367/decor_plants_xwx659.webp"/>
        </div>
        <div class="landing-title mt-0 ">ПРОГРАМА КУРСУ</div>

        <div class="container">

            <div class="program-grid ">
                @* Виводимо перші 3 модулі *@
                @foreach (var module in visibleModules)
                {
                    <div class="module-row ">
                        <div class="module-number">Модуль @module.ModuleNumber.</div>
                        <div class="module-name">
                            @module.Name

                        </div>
                    </div>
                }
            </div>

            @if (hiddenModules.Any())
            {
                <div class="collapse" id="fullProgram">
                    <div class="program-grid" style="border-top: none;">
                        @foreach (var module in hiddenModules)
                        {
                            <div class="module-row">
                                <div class="module-number">Модуль @module.ModuleNumber.</div>
                                <div class="module-name">
                                    @module.Name

                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="text-end ">
                    <a class="show-more-btn" data-bs-toggle="collapse" href="#fullProgram" role="button">
                        ПОКАЗАТИ УСЮ ПРОГРАМУ
                    </a>
                </div>
            }
        </div>

        <div class="basket-img">
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1776075814/Sidebar_Decoration_ljpp8v.webp"/>
        </div>
    </div>

    <div class="container5">
        <div class="row align-items-start">
            <div class="row align-items-start">

                <div class="col-lg-4 p-3 m-3">
                    <div class="text-content d-flex flex-column ">
                        <div class="landing-title mt-4">РЕЗУЛЬТАТИ КУРСУ</div>
                        <div class="ordinary-text ">
                            Орієнтація у ключових мистецьких періодах
                        </div>
                        <div class="ordinary-text">
                            Розуміння взаємозв’язок мистецтва, історії та культури
                        </div>
                        <div class="ordinary-text">
                            Вміння аналізувати твори різних видів мистецтва
                        </div>
                        <div class="ordinary-text">
                            Систематизована база знань для навчання або роботи
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="gallery-relative-container">
                        <div class="gallery-grid">
                            <div class="gallery-item item-high">
                                <div class="wire wire-left"></div>
                                <div class="wire wire-right"></div>
                                <div class="picture-frame ">
                                    <img
                                        src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778519906/elvis_vwpeqi.webp"
                                        alt="Art 1">
                                </div>
                                <div class="picture-caption">
                                    <span class="title">Елвіс Преслі</span>
                                </div>
                            </div>

                            <div class="gallery-item item-cats">
                                <div class="wire wire-left"></div>
                                <div class="wire wire-right"></div>
                                <div class="picture-frame picture-frame-cats">
                                    <img
                                        src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778519900/cats_fnqran.webp"
                                        alt="Art 2">
                                </div>
                                <div class="picture-caption">
                                    <span class="title">Коханці моєї дружини</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tree-img ">
                        <img
                            src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778522229/Results_Decorative_dbhofx.webp"/>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="container6">
        <div class="p-3 m-3">
            <div class="landing-title mt-4">ПЕРЕВАГИ КУРСУ</div>

        </div>
        <div class="row section-row">
            <div class="col-lg-4 p-3  mini-container">
                <div class="mini-num d-flex justify-content-end">1</div>
                <div class="landing-subtitle ">Комплексний підхід</div>
                <div class="ordinary-text ">
                    Курс охоплює різні види мистецтва: живопис, скульптуру, архітектуру, музику та кіно.
                </div>
            </div>
            <div class="col-lg-4 p-3 mini-container">
                <div class="mini-num d-flex justify-content-end">2</div>
                <div class="landing-subtitle ">Зручність</div>
                <div class="ordinary-text ">
                    Можливість проходити лекції в будь-який час та в будь-якому місці.
                </div>
            </div>
            <div class="col-lg-4 p-3 mini-container">
                <div class="mini-num d-flex justify-content-end">3</div>
                <div class="landing-subtitle ">Практичне засвоєння матеріалу</div>
                <div class="ordinary-text ">
                    До кожного модуля передбачені завдання для закріплення знань і самостійного аналізу.
                </div>
            </div>
            <div class="submit-btn" style="  border-top: 2px solid #2B31B4;">
                <a class="submit-btn-text p-2"
                   asp-controller="Auth"
                   asp-action="Register">
                    ЗАПИСАТИСЯ
                </a>
            </div>
        </div>
    </div>

    <div class="container7" id="container7">
        <div class="p-3 m-3 mb-0 pb-0 header-container">
            <div class="landing-title mt-4">АВТОРИ КУРСУ</div>
        </div>

        <div class="authors-slider-wrapper">
            <div
                class="d-flex row flex-nowrap flex-lg-wrap justify-content-start justify-content-lg-around m-2 p-2 g-4 authors-slider"
                id="authorsSlider">

                <div class="col-lg-4 col-12 p-4 mini-container">
                    <div class="author-img">
                        <img
                            src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778602608/5617d5bdffda33041a60e594663344de576b7e69_yddurt.png"
                            alt="Олена Кравчук"/>
                    </div>
                    <div class="landing-subtitle mb-2 mt-4">Олена Кравчук</div>
                    <div class="ordinary-text">
                        Кандидатка мистецтвознавства<br/>
                        <span class="author-text">Викладачка історії мистецтва, дослідниця європейського модернізму<br/>10+ років викладання у вищих навчальних закладах</span>
                    </div>
                </div>

                <div class="col-lg-4 col-12 p-4 mini-container">
                    <div class="author-img">
                        <img
                            src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778602618/1a5e31c3d5963856f9b153d57b37c27fe3b9d11c_ai6ito.png"
                            alt="Андрій Мельник"/>
                    </div>
                    <div class="landing-subtitle mb-2 mt-4">Андрій Мельник</div>
                    <div class="ordinary-text">
                        Мистецтвознавець, cultural аналітик<br/>
                        <span class="author-text">Спеціалізація — мистецтво ХХ століття та кіно<br/>Лектор публічних освітніх програм і курсів</span>
                    </div>
                </div>

                <div class="col-lg-4 col-12 p-4 mini-container">
                    <div class="author-img">
                        <img
                            src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778602628/d17b0fe32d85353492c2fa66165aac0ff4dbbff4_1_ysvjbr.png"
                            alt="Марія Романюк"/>
                    </div>
                    <div class="landing-subtitle mb-2 mt-4">Марія Романюк</div>
                    <div class="ordinary-text mb-2">
                        Історикиня архітектури<br/>
                        <span class="author-text">Досвід роботи з музейними та освітніми проєктами 10 років</span>
                    </div>
                </div>

            </div>
        </div>

        <div class="review-arrow d-flex d-lg-none justify-content-between align-items-center px-4 mt-1">
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646623/scrollLeft_fucspj.svg"
                 class="slider-arrow-img"
                 onclick="scrollAuthorsSlider(-1)"
                 alt="scrollLeft"/>
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646633/scrollRight_guxmdt.svg"
                 class="slider-arrow-img"
                 onclick="scrollAuthorsSlider(1)"
                 alt="scrollRight"/>
        </div>
    </div>

    <div class="container8" id="container8">
        <div class="p-3 m-3 mb-0 pb-0 d-flex justify-content-between align-baseline header-row">
            <div class="landing-title mt-4">ВІДГУКИ</div>

            <div class="review-arrow  d-none d-lg-flex align-items-center px-3 ">
                <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646623/scrollLeft_fucspj.svg"
                     class="slider-arrow-img px-3"
                     onclick="scrollSlider(-1)"
                     alt="scrollLeft"/>
                <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646633/scrollRight_guxmdt.svg"
                     class="slider-arrow-img px-3"
                     onclick="scrollSlider(1)"
                     alt="scrollRight"/>
            </div>
        </div>

        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            <div class="slider-wrapper px-4 py-1" style="overflow: hidden;">
                <div id="reviewsSlider" class="d-flex" style="scroll-behavior: smooth; gap: 20px;">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="review-card-container">
                            <div class="d-flex align-items-center mb-0">
                                <div class="blue-tint"
                                     style="background-image: url('https://res.cloudinary.com/daxjj6p5c/image/upload/v1778668767/a8e13e3251a9bf9bde246e4b297ea74f4e09684f_xerdly.png')"></div>
                            </div>

                            <div class="ordinary-text">
                                @review.Content
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        else
        {
            <div class="col-12 text-center text-muted">
                <p>Тут поки немає відгуків. Станьте першим!</p>
            </div>
        }


        <div class="review-arrow-mobile d-flex d-lg-none justify-content-between align-items-center px-4 mt-1">
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646623/scrollLeft_fucspj.svg"
                 class="slider-arrow-img-mob"
                 onclick="scrollSlider(-1)"
                 alt="scrollLeft"/>
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646633/scrollRight_guxmdt.svg"
                 class="slider-arrow-img-mob"
                 onclick="scrollSlider(1)"
                 alt="scrollRight"/>
        </div>

        <div class="text-end m-3 px-2 mb-4 btn-wrapper">
            <button type="button"
                    class="submit-btn-text"
                    data-bs-toggle="modal"
                    data-bs-target="#reviewModal">
                ЗАЛИШИТИ ВІДГУК
            </button>


        </div>
        <div class="review-img">
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407489/decor_reviews_pm5dru.webp"/>
        </div>

    </div>

    <div class="container9">
        <div class="p-3 m-3">
            <div class="landing-title mt-4">ЯК ЗАПИСАТИСЯ НА КУРС</div>

        </div>
        <div class="row">
            <div class="col-4 p-3  mini-container">
                <div class="landing-subtitle ">Реєстрація</div>
                <div class="ordinary-text ">
                    Введення основних даних для створення облікового запису на платформі.
                </div>
            </div>
            <div class="col-4 p-3 mini-container">
                <div class="landing-subtitle ">Оплата курсу</div>
                <div class="ordinary-text ">
                    Після проходження першого модуля ви можете оплатити доступ до всіх наступних модулів.
                </div>
            </div>
            <div class="col-4 p-3 mini-container">
                <div class="landing-subtitle ">Доступ до навчання</div>
                <div class="ordinary-text ">
                    Після оплати відкривається повний доступ до платформи: відеолекцій, навчальних матеріалів і
                    практичних завдань.
                </div>
            </div>
        </div>
    </div>

    <div class="container10">
        <div class="mini-container">
            <div>
                <div class="landing-title ">ВАРТІСТЬ</div>
            </div>

            <div class="landing-subtitle ">₴ 1 500</div>
            <div class="bird-img2">
                <img
                    src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407512/Hero_Decorative_Bird_cxty3x.webp"/>
            </div>
            <div class="ordinary-text ">
                У вартість входить: доступ до платформи, всі лекції, практичні завдання, додаткові матеріали, можливість
                завантажувати лекції.
            </div>
        </div>
    </div>

    <div class="container11">
        <div class="registration-container ">
            <!-- Ліва частина: Заголовок -->
            <div class="registration-info">
                <h2 class="info-title">Вдоскональте власні знання про історію мистецтва</h2>
                <h1 class="main-cta">ЗАРЕЄСТРУВАТИСЯ<br>НА КУРС</h1>
            </div>

            <!-- Права частина: Форма -->
            <form class="registration-form">
                <div class="form-group">
                    <input type="text" placeholder="Ім'я та прізвище*" required>
                </div>
                <div class="form-group">
                    <input type="email" placeholder="Email*" required>
                </div>
                <div class="form-group">
                    <input type="tel" placeholder="+38" required>
                </div>
        
                <a asp-controller="Auth" asp-action="Register" class="register-btn text-decoration-none d-inline-block text-center">
                    ЗАРЕЄСТРУВАТИСЯ
                </a>
            </form>
        </div>
    </div>

    <div class="container12">
        <div class="plants-img d-flex justify-content-end ">
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1778407367/decor_plants_xwx659.webp"/>
        </div>
        <div class="d-flex justify-content-around p-2 m-2 container12-mini" style="border-bottom:2px solid #FFFFFF">
            <div class="landing-title mt-0 ">ARTLINE</div>
            <div class="ordinary-text mt-4">info@artline.com</div>
            <div class="ordinary-text mt-4">+38 068 000 00 00</div>
        </div>
        <div>

        </div>
        <div class="d-flex flex-row justify-content-around last-container">
            <nav class="nav flex-column mt-4">
                <a href="#container2" class="nav-link-landing ">
                    ПРО КУРС
                </a>
                <a href="#container4" class="nav-link-landing">
                    ПРОГРАМА
                </a>
                <a href="#container7" class="nav-link-landing">
                    АВТОРИ
                </a>
                <a href="#container8" class="nav-link-landing">
                    ВІДГУКИ
                </a>
            </nav>
            <div>
                <form class="email-form">
                    <div class="ordinary-text mt-4">ПІДПИСАТИСЯ НА РОЗСИЛКУ</div>
                    <div class="form-group">
                        <input type="email" placeholder="Ваша пошта" required>
                    </div>
                    <button type="submit" class="register-btn">ПІДПИСАТИСЯ</button>
                </form>
             
            </div>
        </div>
    </div>

</div>

<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content p-3" style="background-color: #2B31B4; color: white;">
            <div class="modal-header border-0">
                <h5 class="modal-title ">ЗАЛИШИТИ ВІДГУК</h5>
                <button type="button" class="btn-close btn-close-white mb-3" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <form asp-controller="User" asp-action="AddReview" method="post">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Текст відгуку</label>
                            <textarea name="Content" class="form-control" rows="4" required></textarea>
                        </div>
                        <input type="hidden" name="Rating" value="5"/>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="submit" class="submit-btn-text border-white border p-2">ВІДПРАВИТИ</button>
                    </div>
                </form>
            }
            else
            {
                <div class="modal-body text-center p-5">
                    <i class="bi bi-person-lock" style="font-size: 3rem;"></i>
                    <p class="modal-text mt-3">Щоб залишити відгук, будь ласка, увійдіть у свій аккаунт.</p>
                    <a asp-controller="Auth"
                       asp-action="Login"
                       asp-route-returnUrl="@Context.Request.Path#container8"
                       class="btn btn-outline-light mt-2">УВІЙТИ</a>
                </div>
            }
        </div>
    </div>
</div>



<script>
 
    document.addEventListener("DOMContentLoaded", function () {
        const collapseElement = document.getElementById('fullProgram');
        const btn = document.querySelector('.show-more-btn');
        const fullProgram = document.getElementById('fullProgram');

        const decorationImg = document.querySelector('.basket-img');
        const programSection = document.querySelector('.program-section');

        fullProgram.addEventListener('show.bs.collapse', function () {
            // Ховаємо картинку
            btn.innerHTML = 'ЗГОРНУТИ ПРОГРАМУ';
            if (decorationImg) decorationImg.classList.add('img-hidden');

            programSection.classList.add('program-expanded');
        });

        fullProgram.addEventListener('hide.bs.collapse', function () {
            btn.innerHTML = 'ПОКАЗАТИ УСЮ ПРОГРАМУ';
            // Повертаємо картинку, коли програма згортається
            if (decorationImg) decorationImg.classList.remove('img-hidden');
            programSection.classList.remove('program-expanded');
        });
    });

    function scrollSlider(direction) {
        const slider = document.getElementById('reviewsSlider');
        if (!slider) {
            console.error("Слайдер reviewsSlider не знайдено!");
            return;
        }

        // Беремо першу ліпшу картку всередині слайдера
        const firstItem = slider.querySelector('.review-card-container');

        if (firstItem) {
            // Вираховуємо ширину картки + відступ (gap)
            const scrollAmount = firstItem.offsetWidth + 20;

            slider.scrollBy({
                left: direction * scrollAmount,
                behavior: 'smooth'
            });


        } else {
            console.error("Картки .review-card-container не знайдені всередині слайдера!");
        }
    }

    function scrollAuthorsSlider(direction) {
        const slider = document.getElementById('authorsSlider');
        if (!slider) return;

        // Визначаємо ширину однієї картки разом із її зовнішніми відступами
        const card = slider.querySelector('.mini-container');
        if (!card) return;

        const cardWidth = card.getBoundingClientRect().width + 20; // 20 — це margin-right


        slider.scrollBy({
            left: direction * cardWidth,
            behavior: 'smooth'
        });
    }
</script>

