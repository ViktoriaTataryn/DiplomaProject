<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ARTLINE Admin - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
            :root {
                --primary-blue: #2B31B4;
                --bg-color: #F2F2FA;
                --sidebar-width: 284px;
                --header-height: 71px; /* Параметр из Figma: Ready for dev */
            }

            body {
                background-color: var(--bg-color);
                font-family: 'Gilroy', sans-serif;
                margin: 0;
            }

            /* Фиксированная шапка */
            #admin-header {
                height: var(--header-height);
                background: #FFFFFF;
                display: flex;
                align-items: center;
                padding: 0 40px;
                position: fixed;
                width: 100%;
                top: 0;
                z-index: 1000;
                box-shadow: 0px 2px 5px rgba(0,0,0,0.02);
            }

            /* Сайдбар */
            #admin-sidebar {
                width: var(--sidebar-width);
                height: 100vh;
                position: fixed;
                top: var(--header-height);
                left: 0;
                background: #FFFFFF;
                border-right: 1px solid rgba(43, 49, 180, 0.1);
                padding: 30px 0; /* Убрал боковые отступы для ссылок, они внутри nav-link */
                display: flex;
                flex-direction: column;
            }

            /* Контентная область */
            #admin-content {
                margin-left: var(--sidebar-width);
                margin-top: var(--header-height);
                padding: 40px;
            }

            /* Ссылки навигации админа */
            .admin-sidebar-nav {
                padding: 0 20px;
            }

            .nav-link {
                color: var(--primary-blue);
                font-family: 'Gilroy';
                font-weight: 300;
                font-size: 18px;
                padding: 12px 15px;
                border-radius: 10px;
                margin-bottom: 8px;
                transition: background-color 0.2s;
            }

                .nav-link:hover {
                    background: rgba(43, 49, 180, 0.02);
                }

                .nav-link.active {
                    background: rgba(43, 49, 180, 0.05);
                    font-weight: 600;
                }
    </style>
</head>
<body>
    <header id="admin-header">
        <div style="font-family: 'Accia Piano'; font-size: 36px; color: var(--primary-blue); text-transform: uppercase;">
            Artline<span style="font-family: 'ShellyAllegroC';">.admin</span>
        </div>
        <div class="ms-auto d-flex align-items-center">
            <span class="me-3" style="font-family: 'Gilroy'; font-weight: 500; color: var(--primary-blue);">@User.Identity?.Name</span>
            <div style="width: 44px; height: 44px; background: #D9D9D9; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-person-fill" style="color: white; font-size: 24px;"></i>
            </div>
        </div>
    </header>

    <aside id="admin-sidebar">
        <nav class="nav flex-column admin-sidebar-nav">
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Admin" asp-action="Index">
                Головна
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "GetStudents" ? "active" : "")"
                   asp-controller="Admin" asp-action="GetStudents">
                Студенти
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "GetModules" || ViewContext.RouteData.Values["Action"]?.ToString() == "AddModule" || ViewContext.RouteData.Values["Action"]?.ToString() == "UpdateModule" ? "active" : "")"
                   asp-controller="Admin" asp-action="GetModules">
                Керування модулями
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "GetLessons" || ViewContext.RouteData.Values["Action"]?.ToString() == "AddLesson" || ViewContext.RouteData.Values["Action"]?.ToString() == "UpdateLesson" ? "active" : "")"
                   asp-controller="AdminLesson" asp-action="GetLessons">
                Керування лекціями
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "UpdateData" ? "active" : "")"
                   asp-controller="User" asp-action="UpdateData">
                Акаунт
            </a>
        </nav>
        
        <div style="margin-top: auto; padding: 20px; text-align: center;">
            <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1776075814/Sidebar_Decoration_ljpp8v.webp" alt="Decoration" style="max-width: 186px;" />
        </div>
    </aside>

    <main id="admin-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>