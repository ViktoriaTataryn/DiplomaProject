<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ARTLINE - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
            body {
                display: flex;
                min-height: 100vh;
                background-color: #f8f9fa;
                flex-direction: column;
                /*  background-color: #F3F3FB; */
            }
    </style>
</head>
<body>
   
    <header id="header">
        <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1775646612/Logo_jhzjc9.svg" style="width:225px" alt="logo" />
        <button class="btn d-md-none me-3" id="sidebarToggle" style="border: none; background: transparent;">
            <i class="bi bi-list fs-2"></i>
        </button>


        <div class="ms-auto d-flex align-items-center">
            <span class="me-3">@User.Identity?.Name</span>

            @*    <i class="bi bi-person-circle fs-4 me-3 pointer-event"></i> *@
            <a asp-controller="User" asp-action="UpdateData" class="text-decoration-none text-dark">
                <i class="bi bi-person-circle fs-4 me-3" style="cursor: pointer;"></i>
            </a>

            @*   <form asp-controller="Auth" asp-action="LogOut" method="post" class="d-inline m-0">
                <button type="submit" class="btn btn-outline-danger btn-sm">
                LOGOUT
                </button>
                </form> *@
        </div>
    </header>

    <div id="layout-body">

        <aside id="sidebar">
       
            <nav class="nav flex-column">
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")"
                       asp-controller="User" asp-action="Dashboard">
                    Головна
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Course" ? "active" : "")" asp-controller="Course" asp-action="Index">
                    Лекції
                </a>
                
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "GetUserHomework" ? "active" : "")"
                       asp-controller="User" asp-action="GetUserHomework">
                    Домашні завдання
                </a>
                
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "AdditionalMaterials" ? "active" : "")"
                       asp-controller="Course" asp-action="AdditionalMaterials">
                    Додаткові матеріали
                </a>
                
                <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "UpdateData" ? "active" : "")"
                       asp-controller="User" asp-action="UpdateData">
                    Акаунт
                </a>
            </nav>
            <div class="sidebar-img">
                <img src="https://res.cloudinary.com/daxjj6p5c/image/upload/v1776075814/Sidebar_Decoration_ljpp8v.webp" alt="Alternate Text" />

            </div>
        </aside>

      
    
        <main id="content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            document.getElementById("sidebarToggle").addEventListener("click", function () {
                document.getElementById("sidebar").classList.toggle("show");
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>