<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ARTLINE - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        /* Базовые стили для структуры ARTLINE */
        body { display: flex; min-height: 100vh; background-color: #f8f9fa; }
        #sidebar { width: 280px; background: #fff; border-right: 1px solid #dee2e6; padding: 20px; }
        #main-wrapper { flex: 1; display: flex; flex-direction: column; }
        #header { height: 70px; background: #fff; border-bottom: 1px solid #dee2e6; display: flex; align-items: center; padding: 0 30px; }
        #content { padding: 30px; flex: 1; }
        .nav-link { color: #333; margin-bottom: 10px; border-radius: 8px; }
        .nav-link.active { background-color: #000; color: #fff; }
    </style>
</head>
<body>

    <div id="sidebar">
        <h4 class="mb-5">ARTLINE</h4>
        <nav class="nav flex-column">
            <a class="nav-link active" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door me-2"></i> Dashboard
            </a>
            <a class="nav-link" asp-controller="Course" asp-action="Index">
                <i class="bi bi-book me-2"></i> My Courses
            </a>
            <a class="nav-link" href="#">
                <i class="bi bi-chat-left-text me-2"></i> Messages
            </a>
            <a class="nav-link" href="#">
                <i class="bi bi-gear me-2"></i> Settings
            </a>
        </nav>
    </div>

    <div id="main-wrapper">
        <header id="header">
            <div class="ms-auto d-flex align-items-center">
                <span class="me-3">@User.Identity?.Name</span>
                <i class="bi bi-person-circle fs-4"></i>
            </div>
        </header>

        <main id="content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>