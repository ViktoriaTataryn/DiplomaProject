<style>
    /* Робимо редактор вищим для зручності */
    .ck-editor__editable_inline {
        min-height: 400px;
    }

    .card {
        border-radius: 12px;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
    }

    /* Стилі для контенту лекції */
    .lecture-content img {
        max-width: 100%; /* Картинка не буде ширшою за текст */
        height: auto; /* Зберігаємо пропорції */
        display: block; /* Прибираємо зайві відступи знизу */
        margin: 20px auto; /* Центруємо картинку та додаємо відступи зверху/знизу */
        border-radius: 8px; /* Робимо кути трохи закругленими (як у твоїх карток) */
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Додаємо легку тінь для об'єму */
    }

    /* Якщо ти хочеш, щоб у самому редакторі CKEditor вони теж не були величезними */
    .ck-content img {
        max-width: 100%;
        height: auto;
    }

    .ck-editor__editable_inline {
        min-height: 400px;
        border-radius: 0 0 8px 8px !important;
    }

    /* Стилізуємо панель інструментів (toolbar) */
    .ck.ck-toolbar {
        background-color: #f8f9fa !important;
        border: 1px solid #dee2e6 !important;
        border-radius: 8px 8px 0 0 !important;
    }

    /* Змінюємо колір фокусу (коли натискаєш на редактор) */
    .ck.ck-editor__editable:not(.ck-editor__nested-editable).ck-focused {
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }

    :root {
        --ck-color-base-foreground: #2c3e50;
        --ck-color-base-background: #ffffff;
        --ck-color-toolbar-background: #f1f1f1;
        --ck-border-radius: 10px;
    }
</style>


