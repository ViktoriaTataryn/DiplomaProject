@model diplomaProject.DTOs.CreateLessonDto?

@{
    ViewData["Title"] = "Додати нову лекцію";
}

<form asp-action="Add" id="lessonForm" method="post" enctype="multipart/form-data"
      class="d-flex flex-column bg-white p-4 flex-grow-1 figma-text-blue">
    <h1 class="text-uppercase mb-3">Створення лекції</h1>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="p-2 flex-grow-1">
        <div class="row mb-3">
            <label asp-for="Title" class="col-1">Назва лекції</label>
            <div class="col-11">
                <input asp-for="Title" class="form-control figma-styled" placeholder="Наприклад: Основи композиції"/>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label asp-for="LessonIndex" class="col-1">Номер лекції</label>
            <div class="col-11">
                <input asp-for="LessonIndex" class="form-control figma-styled"/>
                <span asp-validation-for="LessonIndex" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label asp-for="ModuleId" class="col-1">Модуль курсу</label>
            <div class="col-11">
                <select asp-for="ModuleId" class="form-select figma-styled" asp-items="ViewBag.ModuleList">
                    <option value="">-- Оберіть модуль --</option>
                </select>
                <span asp-validation-for="ModuleId" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label asp-for="Description" class="col-1">Короткий опис (для картки
                курсу)</label>
            <div class="col-11">
                <textarea asp-for="Description" class="form-control figma-styled" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label asp-for="Content" class="col-1">Зміст лекції (текст та ілюстрації)</label>
            <div class="col-11">
                <div id="editorjs" class="figma-styled"
                     style="min-height: 400px; cursor: text;"></div>

                <input type="hidden" asp-for="Content" id="contentHiddenInput"/>

                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
        </div>


        <div class="row mb-3">
            <label asp-for="ResourceFiles" class="col-1">Додаткові
                матеріали (можна вибрати кілька)</label>

            <div class="col-11">
                <input asp-for="ResourceFiles" type="file" class="form-control figma-styled" multiple/>
                <span asp-validation-for="ResourceFiles" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-2">
            <button type="submit" class="btn btn-primary figma-styled w-100">Зберегти лекцію</button>
        </div>
        <div class="col-2">
            <a asp-action="Index" class="btn btn-secondary figma-styled w-100">Скасувати</a>
        </div>
    </div>
</form>



