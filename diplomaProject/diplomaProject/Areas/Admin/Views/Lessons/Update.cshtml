@model diplomaProject.DTOs.UpdateLessonDto

<div class="container mt-4">
    <div class="card shadow">
        @* Заголовок картки з динамічною назвою лекції *@
        <div class="card-header bg-primary text-white">
            <h4>Редагування лекції: @Model.Title</h4>
        </div>
        <div class="card-body">
            @* Форма редагування: enctype обов'язковий для завантаження файлів (NewResources) *@
            <form asp-action="Update" id="editLessonForm" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id"/>

                @* Основні поля лекції *@
                <div class="mb-3">
                    <label asp-for="Title" class="form-control-label">Назва лекції</label>
                    <input asp-for="Title" class="form-control" placeholder="Введіть назву..."/>
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label>Оберіть модуль</label>
                    <select asp-for="ModuleId" class="form-control" asp-items="ViewBag.Modules">
                        <option value="">-- Оберіть модуль --</option>
                    </select>
                    <span asp-validation-for="ModuleId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-control-label">Опис лекції</label>
                    <input asp-for="Description" class="form-control" placeholder="Введіть опис..."/>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                @* Контейнер для візуального редактора Editor.js *@
                <div id="editorjs" class="border rounded bg-white p-3" style="min-height: 400px;"></div>
                @* Приховане поле, куди JS запише фінальний JSON перед відправкою *@
                <input type="hidden" asp-for="Content" id="contentHiddenInput"/>

                @* Блок управління існуючими додатковими матеріалами *@
                <div class="mb-4 mt-4">
                    <label class="form-control-label"><strong>Поточні додаткові матеріали:</strong></label>

                    @if (Model.ExistingResources.Any())
                    {
                        <div class="list-group mt-2">
                            @foreach (var resource in Model.ExistingResources)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-file-alt text-primary me-2"></i>
                                        <a href="@resource.FilePath" target="_blank" class="text-decoration-none">
                                            @resource.FileName
                                        </a>
                                    </div>
                                    @* Кнопка видалення ресурсу (викликає JS функцію) *@
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            onclick="deleteResource(@resource.Id, this)">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">Додаткових матеріалів поки немає.</p>
                    }
                </div>

                @* Поле для завантаження нових файлів *@
                <div class="mb-4">
                    <label class="form-control-label">Додати нові матеріали (Зображення/PDF)</label>
                    <input type="file" name="NewResources" class="form-control" multiple/>
                    <small class="text-muted">Ви можете обрати кілька файлів одночасно.</small>
                </div>

                @* Навігаційні кнопки *@
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
                    <button type="submit" class="btn btn-success">Зберегти зміни</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @* Підключення скриптів редактора та його інструментів *@
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/editorjs@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/header@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/list@@1.8.0"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/image@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@editorjs/quote@latest"></script>

    <script>
        // 1. Отримуємо початкові дані з моделі для Editor.js
        const initialData = @Html.Raw(string.IsNullOrEmpty(Model.Content) ? "{\"blocks\":[]}" : Model.Content);

        // 2. Ініціалізація редактора
        const editor = new EditorJS({
            holder: 'editorjs',
            placeholder: 'Продовжуйте редагування лекції...',
            data: initialData,
            tools: {
                header: {
                    class: Header,
                    inlineToolbar: ['link'],
                },
                quote: {
                    class: Quote,
                    inlineToolbar: true,
                    config: {
                        quotePlaceholder: 'Введіть цитату',
                        captionPlaceholder: 'Автор цитати',
                    },
                },
                list: {
                    class: List,
                    inlineToolbar: true
                },
                image: {
                    class: ImageTool,
                    config: {
                        endpoints: {
                            byFile: '/AdminLesson/UploadImage' // Метод контролера для обробки зображень
                        },
                        field: 'file',
                        actions: [
                            {
                                name: 'size_small',
                                icon: 'S',
                                title: 'Маленька (30%)',
                                toggle: true,
                            },
                            {
                                name: 'size_medium',
                                icon: 'M',
                                title: 'Середня (60%)',
                                toggle: true,
                            }
                        ]
                    }
                }
            },
            onReady: () => {
                console.log('Editor.js готовий до роботи!');
            }
        });

        // 3. Скрипт передвідправки форми
        const editForm = document.getElementById('editLessonForm');
        editForm.addEventListener('submit', async (e) => {
            e.preventDefault(); // Зупиняємо, щоб встигнути витягнути дані з Editor.js

            try {
                const savedData = await editor.save();
                const contentInput = document.getElementById('contentHiddenInput');
                contentInput.value = JSON.stringify(savedData); // Конвертуємо JSON об'єкт у рядок
                editForm.submit();
            } catch (error) {
                console.error('Помилка при збереженні:', error);
                alert('Сталася помилка при спробі зберегти контент лекції.');
            }
        });

        // 4. Функція видалення ресурсу (імітація або AJAX запит)
        function deleteResource(id, element) {
            if (confirm("Ви впевнені, що хочете видалити цей файл?")) {
                // Тут можна додати AJAX запит до сервера. 
                // Поки що просто видаляємо елемент зі списку на сторінці.
                element.closest('.list-group-item').remove();
            }
        }
    </script>
}