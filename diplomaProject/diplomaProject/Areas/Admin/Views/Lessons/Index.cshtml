@model IEnumerable<Lesson>
@{
    ViewData["Title"] = "Керування лекціями";
}

<div class="d-flex flex-column bg-white p-4 flex-grow-1 figma-text-blue">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-uppercase">Керування лекціями</h1>
        <a asp-action="Add" class="btn btn-primary figma-styled">
            <i class="fas fa-plus"></i> Додати нову лекцію
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered figma-styled mb-0">
            <thead>
            <tr>
                <th>ID</th>
                <th>Назва лекції</th>
                <th>Модуль</th>
                <th>Студентів завершило</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var lesson in Model)
            {
                <tr>
                    <td>@lesson.Id</td>
                    <td>@lesson.Title</td>
                    <td>@lesson.ModuleIndex</td>
                    <td>@lesson.UserCompletedNum</td>
                    <td class="text-end">
                        <a asp-action="Update" asp-route-id="@lesson.Id"
                           class="btn btn-primary btn-sm figma-styled p-0 square" style="height: 30px">
                            <i class="bi bi-pen"></i>
                        </a>
                        <a asp-area=""
                           asp-controller="Course"
                           asp-action="AddQuestion"
                           asp-route-lectureId="@lesson.Id"
                           class="btn btn-secondary btn-sm figma-styled p-0 square" style="height: 30px">
                            <i class="bi bi-plus"></i>
                        </a>
                        <form asp-action="DeleteLesson" asp-route-id="@lesson.Id" method="post"
                              onsubmit="return confirm('Ви впевнені, що хочете видалити лекцію?');"
                              style="display:inline;">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-danger btn-sm figma-styled p-0 square"
                                    style="height: 30px">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
