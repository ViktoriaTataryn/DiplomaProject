@model IEnumerable<Lesson>
@{
    ViewData["Title"] = "Керування лекціями";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Керування лекціями</h2>
        <a asp-action="Add" class="btn btn-success">
            <i class="fas fa-plus"></i> Додати нову лекцію
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Назва лекції</th>
                    <th>Модуль</th>
                    <th>Студентів завершило</th>
                    <th class="text-end">Дії</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var lesson in Model)
                {
                    <tr>
                        <td>@lesson.Id</td>
                        <td>@lesson.Title</td>
                        <td>@lesson.ModuleIndex</td>
                        <td>@lesson.UserCompletedNum</td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <a asp-action="Update" asp-route-id="@lesson.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-edit"></i> Редагувати
                                </a>
                                <a asp-area=""
                                   asp-controller="Course"
                                   asp-action="AddQuestion"
                                   asp-route-lectureId="@lesson.Id"
                                   class="btn btn-sm btn-primary">
                                    + Додати тест
                                </a>
                                <form asp-action="DeleteLesson" asp-route-id="@lesson.Id" method="post"
                                      onsubmit="return confirm('Ви впевнені, що хочете видалити лекцію?');"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-trash"></i> Видалити
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
