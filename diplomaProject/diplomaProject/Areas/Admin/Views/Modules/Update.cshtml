@using System.Text.Encodings.Web
@model diplomaProject.DTOs.UpdateModuleDto
@{
    ViewData["Title"] = "Редагування модуля";
}

@section Head
{
    <link rel="stylesheet" href="~/css/admin-module-file-selector.css" asp-append-version="true"/>
    <style>
        [x-data="lessons"] {
            border: 1px solid var(--primary-blue);
            color: var(--primary-blue);
            padding: 1rem 1.5rem;

            button {
                border: none;
                color: var(--primary-blue);
                background-color: transparent;

                &:disabled {
                    opacity: 0.6;
                }
            }
        }
    </style>
}

<form asp-action="Update" id="editModuleForm" method="post" enctype="multipart/form-data"
      class="d-flex flex-column bg-white p-4 flex-grow-1 figma-text-blue">
    <h1 class="text-uppercase mb-3">Редагувати модуль</h1>
    <div class="p-2 flex-grow-1">
        <input type="hidden" asp-for="Id"/>

        <div class="row mb-3">
            <label asp-for="Title" class="col-1">Назва модуля</label>
            <div class="col-11">
                <input asp-for="Title" class="form-control figma-styled" placeholder="Введіть назву..."/>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label asp-for="OrderIndex" class="col-1">Номер модуля</label>
            <div class="col-11">
                <input asp-for="OrderIndex" class="form-control figma-styled"/>
                <span asp-validation-for="OrderIndex" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label asp-for="Description" class="col-1">Опис модуля</label>
            <div class="col-11">
                <input asp-for="Description" class="form-control figma-styled" placeholder="Введіть опис..."/>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label asp-for="ImageFile" class="col-1">Обкладинка модуля</label>
            <div class="col-11">
                <div x-data="fileSelector"
                     data-initial-image="@HtmlEncoder.Default.Encode(Model.ImageForUser ?? string.Empty)">
                    <input type="file" asp-for="ImageFile" x-bind="fileInput" x-ref="fileInput" class="form-control"
                           accept="image/*"/>
                    <img x-show="imageForUser" :src="imageForUser" alt="Preview"/>
                    <div x-show.important="!imageForUser"
                         class="d-flex align-content-center justify-content-center">
                        <i class="bi bi-plus-lg fs-icon"></i>
                    </div>
                    <button x-bind="selector" type="button">
                        <i class="bi bi-plus-lg fs-icon"></i>
                    </button>
                </div>
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <label asp-for="LessonNames" class="col-1">Порядок лекцій</label>
            <div class="col-11">
                <div x-data="lessons">
                    <template x-for="(lesson, index) in lessonNames" :key="index">
                        <div>
                            <hr x-show="index" class="mx-0 my-2 opacity-75"/>
                            <div class="d-flex justify-content-between align-items-center">
                                <input type="hidden" asp-for="LessonNames" x-model="lesson"/>
                                <h4 x-text="lesson" class="mb-0"></h4>
                                <div class="d-flex flex-column">
                                    <button type="button" @@click="moveUp(index)" :disabled="!index">
                                        <i class="bi" :class="index ? 'bi-caret-up-fill' : 'bi-caret-up'"></i>
                                    </button>
                                    <button type="button" @@click="moveDown(index)"
                                            :disabled="index === lessonNames.length - 1">
                                        <i class="bi"
                                           :class="index === lessonNames.length - 1 ? 'bi-caret-down' : 'bi-caret-down-fill'"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
                <span asp-validation-for="LessonNames" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-2">
            <button type="submit" class="btn btn-primary figma-styled w-100">Зберегти зміни</button>
        </div>
        <div class="col-2">
            <a asp-action="Index" class="btn btn-secondary figma-styled w-100">Скасувати</a>
        </div>
    </div>
</form>

@section Scripts {
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.15.11/dist/cdn.min.js"></script>
    <script src="~/js/admin-module-file-selector.js" asp-append-version="true"></script>

    <script>
        function lessons() {
            return {
                lessonNames: @Json.Serialize(Model.LessonNames),
                moveUp(index) {
                    if (index <= 0) return;

                    const newArr = [...this.lessonNames];
                    [newArr[index - 1], newArr[index]] = [newArr[index], newArr[index - 1]];
                    this.lessonNames = newArr;
                },
                moveDown(index) {
                    if (index < 0 || index >= this.lessonNames.length - 1) return;

                    const newArr = [...this.lessonNames];
                    [newArr[index], newArr[index + 1]] = [newArr[index + 1], newArr[index]];
                    this.lessonNames = newArr;
                }
            }
        }

    </script>
}
